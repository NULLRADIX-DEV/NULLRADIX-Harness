        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameProject"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDto"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Stale version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs": {
      "get": {
        "tags": [
          "runs"
        ],
        "operationId": "list_runs",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Newest runs first, at most 500.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunList"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "runs"
        ],
        "operationId": "start_run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRun"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "URL of the new run"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunDto"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Browser sessions cannot start runs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The runner could not start it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/runs/{id}": {
      "get": {
        "tags": [
          "runs"
        ],
        "operationId": "get_run",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Run id.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunDto"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{id}/cancel": {
      "post": {
        "tags": [
          "runs"
        ],
        "operationId": "cancel_run",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Run id.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "The run was asked to stop",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunDto"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The run already finished",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{id}/output": {
      "get": {
        "tags": [
          "runs"
        ],
        "operationId": "run_output",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Run id.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Return lines after this sequence number.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "At most this many lines, up to 1000.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOutput"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeDto": {
        "type": "object",
        "description": "Data of a `change` event; the event id carries `seq`.",
        "required": [
          "seq",
          "entity",
          "entityId",
          "op",
          "at"
        ],
        "properties": {
          "at": {
            "type": "integer",
            "format": "int64"
          },
          "entity": {
            "$ref": "#/components/schemas/EntityDto"
          },
          "entityId": {
            "type": "string",
            "format": "uuid"
          },
          "op": {
            "$ref": "#/components/schemas/ChangeOpDto"
          },
          "seq": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ChangeOpDto": {
        "type": "string",
        "enum": [
          "insert",
          "update",
          "delete"
        ]
      },
      "CreateProject": {
        "type": "object",
        "required": [
          "key",
          "name"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "EntityDto": {
        "type": "string",
        "enum": [
          "project",
          "run"
        ]
      },
      "Handoff": {
        "type": "object",
        "description": "One-time code that opens a browser session.",
        "required": [
          "code",
          "path"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version",
          "apiVersion"
        ],
        "properties": {
          "apiVersion": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "HookEventDto": {
        "type": "object",
        "description": "One hook report; unknown fields are ignored because hooks skip the version handshake.",
        "required": [
          "id",
          "sessionId",
          "cwd",
          "occurredAt"
        ],
        "properties": {
          "agentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "agentType": {
            "type": [
              "string",
              "null"
            ]
          },
          "cwd": {
            "type": "string",
            "description": "Absolute working directory of the session."
          },
          "entrypoint": {
            "type": [
              "string",
              "null"
            ],
            "description": "Which Claude client ran the hook."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Chosen by the reporter, so a resend is recognised."
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "notificationType": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "integer",
            "format": "int64",
            "description": "Unix milliseconds."
          },
          "prompt": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "run": {
            "type": [
              "string",
              "null"
            ],
            "description": "Run that started the session."
          },
          "sessionId": {
            "type": "string"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "ticket": {
            "type": [
              "string",
              "null"
            ],
            "description": "Ticket key the session was started for."
          },
          "transcriptPath": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
