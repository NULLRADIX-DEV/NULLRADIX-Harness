{
  "title": "The code switch of a theme is off by default, only the person in the app can turn it on, and scripts are not served while it is off",
  "steps": [
    {
      "name": "manifest with a domain",
      "file": {
        "path": "{{WORK}}/night-code/manifest.json",
        "text": "{\"id\":\"night-code\",\"name\":\"Night Code\",\"version\":\"1.0.0\",\"author\":\"Ada\",\"sdkVersion\":\"^1.3\",\"colorScheme\":\"dark\",\"slots\":[],\"permissions\":{\"network\":[\"fonts.example.com\"]}}"
      }
    },
    {
      "name": "stylesheet",
      "file": {
        "path": "{{WORK}}/night-code/theme.css",
        "text": "a { color: red }\n"
      }
    },
    {
      "name": "script",
      "file": {
        "path": "{{WORK}}/night-code/main.js",
        "text": "export default { id: 'night-code', slots: {} };\n"
      }
    },
    {
      "name": "pack the folder",
      "cli": {
        "args": ["theme", "pack", "{{WORK}}/night-code", "--out", "{{WORK}}/v1.nullradix"]
      }
    },
    {
      "name": "install the confirmed package",
      "cli": {
        "args": ["theme", "install", "{{WORK}}/v1.nullradix", "--yes"]
      }
    },
    {
      "name": "the theme has code and the switch is off",
      "http": {
        "method": "GET",
        "path": "/api/v1/themes"
      }
    },
    {
      "name": "the module is not served while the switch is off",
      "http": {
        "method": "GET",
        "path": "/api/v1/themes/night-code/files/main.js"
      }
    },
    {
      "name": "a token cannot turn the code on",
      "http": {
        "method": "PUT",
        "path": "/api/v1/themes/night-code/code",
        "body": {
          "enabled": true,
          "version": 1
        }
      }
    },
    {
      "name": "a token cannot turn it on for an unknown theme either",
      "http": {
        "method": "PUT",
        "path": "/api/v1/themes/missing-theme/code",
        "body": {
          "enabled": true,
          "version": 1
        }
      }
    },
    {
      "name": "a token may turn it off, without a version",
      "http": {
        "method": "PUT",
        "path": "/api/v1/themes/night-code/code",
        "body": {
          "enabled": false
        }
      }
    },
    {
      "name": "turning off an unknown theme finds none",
      "http": {
        "method": "PUT",
        "path": "/api/v1/themes/missing-theme/code",
        "body": {
          "enabled": false
        }
      }
    },
    {
      "name": "the module is still not served",
      "http": {
        "method": "GET",
        "path": "/api/v1/themes/night-code/files/main.js"
      }
    },
    {
      "name": "the same package again",
      "cli": {
        "args": ["theme", "install", "{{WORK}}/v1.nullradix", "--yes"]
      }
    },
    {
      "name": "the list after an update that adds nothing",
      "http": {
        "method": "GET",
        "path": "/api/v1/themes"
      }
    },
    {
      "name": "manifest of an update with another domain",
      "file": {
        "path": "{{WORK}}/night-code/manifest.json",
        "text": "{\"id\":\"night-code\",\"name\":\"Night Code\",\"version\":\"1.1.0\",\"author\":\"Ada\",\"sdkVersion\":\"^1.3\",\"colorScheme\":\"dark\",\"slots\":[],\"permissions\":{\"network\":[\"fonts.example.com\",\"cdn.example.com\"]}}"
      }
    },
    {
      "name": "pack the update",
      "cli": {
        "args": ["theme", "pack", "{{WORK}}/night-code", "--out", "{{WORK}}/v2.nullradix"]
      }
    },
    {
      "name": "install the update that adds a domain",
      "cli": {
        "args": ["theme", "install", "{{WORK}}/v2.nullradix", "--yes"]
      }
    },
    {
      "name": "the switch is off after the update that adds a domain",
      "http": {
        "method": "GET",
        "path": "/api/v1/themes"
      }
    },
    {
      "name": "a theme without code has no switch to turn on",
      "file": {
        "path": "{{WORK}}/plain/manifest.json",
        "text": "{\"id\":\"plain-blue\",\"name\":\"Plain Blue\",\"version\":\"1.0.0\",\"author\":\"Ada\",\"sdkVersion\":\"^1.3\",\"colorScheme\":\"dark\",\"slots\":[],\"permissions\":{\"network\":[]}}"
      }
    },
    {
      "name": "plain stylesheet",
      "file": {
        "path": "{{WORK}}/plain/theme.css",
        "text": "a { color: blue }\n"
      }
    },
    {
      "name": "pack the plain theme",
      "cli": {
        "args": ["theme", "pack", "{{WORK}}/plain", "--out", "{{WORK}}/plain.nullradix"]
      }
    },
    {
      "name": "install the plain theme",
      "cli": {
        "args": ["theme", "install", "{{WORK}}/plain.nullradix"]
      }
    },
    {
      "name": "turning the code of a theme without code off is fine",
      "http": {
        "method": "PUT",
        "path": "/api/v1/themes/plain-blue/code",
        "body": {
          "enabled": false
        }
      }
    },
    {
      "name": "uninstall the theme",
      "cli": {
        "args": ["theme", "remove", "night-code"]
      }
    },
    {
      "name": "a reinstall starts with the switch off",
      "cli": {
        "args": ["theme", "install", "{{WORK}}/v2.nullradix", "--yes"]
      }
    },
    {
      "name": "the new install is off",
      "http": {
        "method": "GET",
        "path": "/api/v1/themes"
      }
    }
  ]
}
