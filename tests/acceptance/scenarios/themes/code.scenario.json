{
  "title": "The code switch of a theme is off until turned on for the version seen, and an update that adds something turns it off",
  "steps": [
    {
      "name": "manifest with a domain",
      "file": {
        "path": "{{WORK}}/night-code/manifest.json",
        "text": "{\"id\":\"night-code\",\"name\":\"Night Code\",\"version\":\"1.0.0\",\"author\":\"Ada\",\"sdkVersion\":\"^1.3\",\"colorScheme\":\"dark\",\"slots\":[],\"permissions\":{\"network\":[\"fonts.example.com\"]}}"
      }
    },
    {
      "name": "stylesheet",
      "file": { "path": "{{WORK}}/night-code/theme.css", "text": "a { color: red }\n" }
    },
    {
      "name": "script",
      "file": {
        "path": "{{WORK}}/night-code/main.js",
        "text": "export default { id: 'night-code', slots: {} };\n"
      }
    },
    {
      "name": "pack the folder",
      "cli": { "args": ["theme", "pack", "{{WORK}}/night-code", "--out", "{{WORK}}/v1.nullradix"] }
    },
    {
      "name": "install the confirmed package",
      "cli": { "args": ["theme", "install", "{{WORK}}/v1.nullradix", "--yes"] }
    },
    {
      "name": "the theme has code and the switch is off",
      "http": { "method": "GET", "path": "/api/v1/themes" }
    },
    {
      "name": "the module is served as javascript",
      "http": { "method": "GET", "path": "/api/v1/themes/night-code/files/main.js" }
    },
    {
      "name": "a stale version cannot turn the switch on",
      "http": {
        "method": "PUT",
        "path": "/api/v1/themes/night-code/code",
        "body": { "enabled": true, "version": 99 }
      }
    },
    {
      "name": "turning the switch on for the version seen",
      "http": {
        "method": "PUT",
        "path": "/api/v1/themes/night-code/code",
        "body": { "enabled": true, "version": 1 }
      }
    },
    {
      "name": "the list shows it on",
      "http": { "method": "GET", "path": "/api/v1/themes" }
    },
    {
      "name": "an unknown theme has no switch",
      "http": {
        "method": "PUT",
        "path": "/api/v1/themes/missing-theme/code",
        "body": { "enabled": true, "version": 1 }
      }
    },
    {
      "name": "the same package again keeps the switch",
      "cli": { "args": ["theme", "install", "{{WORK}}/v1.nullradix", "--yes"] }
    },
    {
      "name": "still on after an update that adds nothing",
      "http": { "method": "GET", "path": "/api/v1/themes" }
    },
    {
      "name": "manifest of an update with another domain",
      "file": {
        "path": "{{WORK}}/night-code/manifest.json",
        "text": "{\"id\":\"night-code\",\"name\":\"Night Code\",\"version\":\"1.1.0\",\"author\":\"Ada\",\"sdkVersion\":\"^1.3\",\"colorScheme\":\"dark\",\"slots\":[],\"permissions\":{\"network\":[\"fonts.example.com\",\"cdn.example.com\"]}}"
      }
    },
    {
      "name": "pack the update",
      "cli": { "args": ["theme", "pack", "{{WORK}}/night-code", "--out", "{{WORK}}/v2.nullradix"] }
    },
    {
      "name": "install the update that adds a domain",
      "cli": { "args": ["theme", "install", "{{WORK}}/v2.nullradix", "--yes"] }
    },
    {
      "name": "the switch is off again",
      "http": { "method": "GET", "path": "/api/v1/themes" }
    },
    {
      "name": "turning it on again",
      "http": {
        "method": "PUT",
        "path": "/api/v1/themes/night-code/code",
        "body": { "enabled": true, "version": 3 }
      }
    },
    {
      "name": "turning it off",
      "http": {
        "method": "PUT",
        "path": "/api/v1/themes/night-code/code",
        "body": { "enabled": false, "version": 3 }
      }
    },
    {
      "name": "a theme without code has no switch to turn on",
      "file": {
        "path": "{{WORK}}/plain/manifest.json",
        "text": "{\"id\":\"plain-blue\",\"name\":\"Plain Blue\",\"version\":\"1.0.0\",\"author\":\"Ada\",\"sdkVersion\":\"^1.3\",\"colorScheme\":\"dark\",\"slots\":[],\"permissions\":{\"network\":[]}}"
      }
    },
    {
      "name": "plain stylesheet",
      "file": { "path": "{{WORK}}/plain/theme.css", "text": "a { color: blue }\n" }
    },
    {
      "name": "pack the plain theme",
      "cli": { "args": ["theme", "pack", "{{WORK}}/plain", "--out", "{{WORK}}/plain.nullradix"] }
    },
    {
      "name": "install the plain theme",
      "cli": { "args": ["theme", "install", "{{WORK}}/plain.nullradix"] }
    },
    {
      "name": "the switch needs a main.js",
      "http": {
        "method": "PUT",
        "path": "/api/v1/themes/plain-blue/code",
        "body": { "enabled": true, "version": 1 }
      }
    },
    {
      "name": "turning it on once more before the uninstall",
      "http": {
        "method": "PUT",
        "path": "/api/v1/themes/night-code/code",
        "body": { "enabled": true, "version": 3 }
      }
    },
    {
      "name": "uninstall the theme",
      "cli": { "args": ["theme", "remove", "night-code"] }
    },
    {
      "name": "a reinstall starts with the switch off",
      "cli": { "args": ["theme", "install", "{{WORK}}/v2.nullradix", "--yes"] }
    },
    {
      "name": "the new install is off",
      "http": { "method": "GET", "path": "/api/v1/themes" }
    }
  ]
}
