[
  {
    "cli": [
      "account",
      "list"
    ],
    "exitCode": 0,
    "name": "list in the CLI",
    "stderr": "",
    "stdout": "default          Default              enabled  5h -     week -     token none the server's own login\n"
  },
  {
    "name": "add over HTTP",
    "request": {
      "body": {
        "name": "Max (private)"
      },
      "method": "POST",
      "path": "/api/v1/accounts"
    },
    "response": {
      "json": {
        "configDir": "<HOME>/data/accounts/max-private",
        "createdAt": "<TIME>",
        "enabled": true,
        "fallback": false,
        "hasRunToken": false,
        "id": "<ID-1>",
        "limitFiveHour": null,
        "limitWeek": null,
        "name": "Max (private)",
        "pauseReason": null,
        "pausedUntil": null,
        "slug": "max-private",
        "updatedAt": "<TIME>",
        "version": 1
      },
      "location": "/api/v1/accounts/<ID-1>",
      "status": 201
    }
  },
  {
    "cli": [
      "account",
      "add",
      "Work"
    ],
    "exitCode": 0,
    "name": "add in the CLI",
    "stderr": "",
    "stdout": "added work (Work)\n"
  },
  {
    "name": "add with a relative folder",
