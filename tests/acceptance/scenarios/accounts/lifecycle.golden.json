  {
    "cli": [
      "account",
      "set",
      "max-private",
      "--limit-five-hour",
      "50",
      "--limit-week",
      "80"
    ],
    "exitCode": 0,
    "name": "set limits in the CLI",
    "stderr": "",
    "stdout": "updated max-private      Max (private)        enabled  5h 50%   week 80%   token none <HOME>/data/accounts/max-private\n"
  },
  {
    "name": "update with a stale version",
    "request": {
      "body": {
        "name": "Max stale",
        "version": 1
      },
      "method": "PATCH",
      "path": "/api/v1/accounts/<ID-1>"
    },
    "response": {
      "json": {
        "code": "version-conflict",
        "detail": "account <ID-1> was changed by someone else, reload and try again",
        "status": 409,
        "title": "Conflict",
        "type": "urn:nullradix:problem:version-conflict"
      },
      "status": 409
    }
  },
  {
    "name": "update a limit out of range",
    "request": {
      "body": {
        "limitWeek": 101,
        "version": 2
      },
      "method": "PATCH",
      "path": "/api/v1/accounts/<ID-1>"
    },
    "response": {
      "json": {
        "code": "account-invalid",
        "detail": "the limit for the week must be a whole number from 1 to 100",
        "status": 422,
        "title": "Unprocessable Entity",
        "type": "urn:nullradix:problem:account-invalid"
      },
      "status": 422
    }
  },
  {
    "cli": [
      "account",
      "set",
      "max-private",
      "--limit-week",
      "none",
      "--fallback",
      "true"
    ],
    "exitCode": 0,
    "name": "remove a limit and make it a fallback",
    "stderr": "",
    "stdout": "updated max-private      Max (private)        fallback 5h 50%   week -     token none <HOME>/data/accounts/max-private\n"
  },
  {
    "cli": [
