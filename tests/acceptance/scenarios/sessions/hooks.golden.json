[
  {
    "name": "project",
    "request": {
      "body": {
        "key": "ARC",
        "name": "Arches"
      },
      "method": "POST",
      "path": "/api/v1/projects"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "id": "<ID-1>",
        "key": "ARC",
        "name": "Arches",
        "updatedAt": "<TIME>",
        "version": 1
      },
      "location": "/api/v1/projects/<ID-1>",
      "status": 201
    }
  },
  {
    "name": "board",
    "request": {
      "body": {
        "name": "Main"
      },
      "method": "POST",
      "path": "/api/v1/projects/<ID-1>/boards"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "dispatchEnabled": true,
        "id": "<ID-2>",
        "name": "Main",
        "openTickets": 0,
        "ownerId": "<ID-3>",
        "ownerName": "tester",
        "projectId": "<ID-1>",
        "projectKey": "ARC",
        "repositoryId": null,
        "repositoryName": null,
        "updatedAt": "<TIME>",
        "version": 1
      },
      "location": "/api/v1/projects/<ID-1>/boards/<ID-2>",
      "status": 201
    }
  },
  {
    "name": "init a repository",
    "request": {
      "body": {
        "args": [
          "init",
          "-q",
          "-b",
          "main",
          "arches"
        ],
        "cwd": "<WORK>",
        "label": "git init",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
      "path": "/api/v1/runs"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "error": null,
        "exitCode": null,
        "finishedAt": null,
        "id": "<ID-4>",
        "label": "git init",
        "startedAt": "<TIME>",
        "status": "running",
        "version": 2
      },
      "location": "/api/v1/runs/<ID-4>",
      "status": 201
    }
  },
  {
    "field": "status",
    "name": "initialized",
    "reached": "succeeded",
    "wait": "/api/v1/runs/<ID-4>"
  },
  {
    "cli": [
      "board",
      "repo",
      "<ID-2>",
      "<WORK>/arches"
    ],
    "exitCode": 0,
    "name": "bind the board",
    "stderr": "",
    "stdout": "board <ID-2> works in arches at <WORK>/arches\n"
  },
  {
    "cli": [
      "ticket",
      "create",
      "Fix the login"
    ],
    "exitCode": 0,
    "name": "a ticket",
    "stderr": "",
    "stdout": "ARC-0001 created: Fix the login\n"
  },
  {
    "cli": [
      "hook",
      "session-start"
    ],
    "exitCode": 0,
    "name": "session start",
    "stderr": "",
    "stdout": ""
  },
  {
    "field": "number",
    "name": "the repository is found",
    "reached": 1,
    "wait": "/api/v1/sessions/s-1"
  },
  {
    "cli": [
      "hook",
      "user-prompt"
    ],
    "exitCode": 0,
    "name": "prompt",
    "stderr": "",
    "stdout": "{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"sessionTitle\":\"SE-001: Fix the login form please now ...\"}}\n"
  },
  {
    "name": "running",
    "request": {
      "method": "GET",
      "path": "/api/v1/sessions/s-1"
    },
