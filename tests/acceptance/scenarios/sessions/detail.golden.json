    }
  },
  {
    "name": "init a repository",
    "request": {
      "body": {
        "args": [
          "init",
          "-q",
          "-b",
          "main",
          "arches"
        ],
        "cwd": "<WORK>",
        "label": "git init",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
      "path": "/api/v1/runs"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "error": null,
        "exitCode": null,
        "finishedAt": null,
        "id": "<ID-4>",
