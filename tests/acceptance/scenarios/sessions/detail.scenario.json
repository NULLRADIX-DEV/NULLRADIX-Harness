{
  "title": "A session shows what it did from its transcript and takes a ticket",
  "env": {
    "CLAUDE_CODE_ENTRYPOINT": "cli",
    "NULLRADIX_HOOK_DEADLINE_MS": "4500"
  },
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": { "key": "ARC", "name": "Arches" }
      },
      "save": { "project": "json.id" }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": { "name": "Main" }
      },
      "save": { "main": "json.id" }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": { "init": "json.id" }
    },
    {
      "name": "initialized",
      "wait": { "path": "/api/v1/runs/{{init}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "bind the board",
      "cli": { "args": ["board", "repo", "{{main}}", "{{WORK}}/arches"] }
    },
    {
      "name": "a ticket",
      "cli": { "args": ["ticket", "create", "Write the notes"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "the transcript Claude Code wrote",
      "file": {
        "path": "{{WORK}}/s-1.jsonl",
        "lines": [
          {
            "type": "user",
            "uuid": "u-1",
            "timestamp": "2026-11-25T08:00:00.000Z",
            "entrypoint": "cli",
            "gitBranch": "main",
            "version": "2.1.0",
            "message": { "role": "user", "content": "Write the notes file please" }
          },
          {
            "type": "assistant",
            "uuid": "a-1",
            "timestamp": "2026-11-25T08:00:01.000Z",
            "thinkingDurationMs": 1500,
            "message": {
              "id": "m-1",
              "model": "fake-opus",
              "content": [
                { "type": "thinking", "thinking": "" },
                {
                  "type": "tool_use",
                  "id": "w-1",
                  "name": "Write",
                  "input": { "file_path": "notes.txt", "content": "one\ntwo\n" }
                }
              ],
              "usage": {
                "input_tokens": 10,
                "output_tokens": 20,
                "cache_read_input_tokens": 300,
                "cache_creation_input_tokens": 40
              }
            }
          },
          {
            "type": "user",
            "uuid": "u-2",
            "timestamp": "2026-11-25T08:00:02.000Z",
            "message": {
              "content": [
                { "type": "tool_result", "tool_use_id": "w-1", "content": "File created" }
              ]
            },
            "toolUseResult": { "type": "create" }
          },
          {
            "type": "assistant",
            "uuid": "a-2",
            "timestamp": "2026-11-25T08:00:03.000Z",
            "message": {
              "id": "m-2",
              "model": "fake-opus",
              "content": [
                {
                  "type": "tool_use",
                  "id": "b-1",
                  "name": "Bash",
                  "input": { "command": "cat notes.txt" }
                }
              ]
            }
          },
          {
            "type": "user",
            "uuid": "u-3",
            "timestamp": "2026-11-25T08:00:04.000Z",
            "message": {
              "content": [
                {
                  "type": "tool_result",
                  "tool_use_id": "b-1",
                  "content": "Exit code 1",
                  "is_error": true
                }
              ]
            }
          },
          {
            "type": "assistant",
            "uuid": "a-3",
            "timestamp": "2026-11-25T08:00:05.000Z",
            "message": {
              "id": "m-3",
              "model": "fake-opus",
              "content": [{ "type": "text", "text": "The notes are written." }]
            }
          }
        ]
      }
    },
    {
      "name": "session start",
      "cli": {
        "args": ["hook", "session-start"],
        "stdin": {
          "session_id": "s-1",
          "cwd": "{{WORK}}/arches",
          "source": "startup",
          "transcript_path": "{{WORK}}/s-1.jsonl"
        }
      }
    },
    {
      "name": "the repository is found",
      "wait": { "path": "/api/v1/sessions/s-1", "field": "number", "equals": 1 }
    },
    {
      "name": "the first prompt names the session",
      "cli": {
        "args": ["hook", "user-prompt"],
        "stdin": {
          "session_id": "s-1",
          "cwd": "{{WORK}}/arches",
          "prompt": "Write the notes file please"
        }
      }
    },
    {
      "name": "a later prompt keeps the name",
      "cli": {
        "args": ["hook", "user-prompt"],
        "stdin": { "session_id": "s-1", "cwd": "{{WORK}}/arches", "prompt": "And check it" }
      }
    },
    {
      "name": "stop",
      "cli": {
        "args": ["hook", "stop"],
        "stdin": { "session_id": "s-1", "cwd": "{{WORK}}/arches" }
      }
    },
    {
      "name": "the detail",
      "http": { "method": "GET", "path": "/api/v1/sessions/s-1/detail" }
    },
    {
      "name": "show with the detail",
      "cli": { "args": ["session", "show", "s-1"] }
    },
    {
      "name": "the transcript",
      "http": { "method": "GET", "path": "/api/v1/sessions/s-1/transcript" }
    },
    {
      "name": "the transcript after its end",
      "http": { "method": "GET", "path": "/api/v1/sessions/s-1/transcript?after=100000&limit=10" }
    },
    {
      "name": "the transcript in the CLI",
      "cli": { "args": ["session", "transcript", "s-1"] }
    },
    {
      "name": "the changes",
      "cli": { "args": ["session", "changes", "s-1"] }
    },
    {
      "name": "the diff",
      "cli": { "args": ["session", "diff", "s-1", "notes.txt"] }
    },
    {
      "name": "a path outside the checkout",
      "http": { "method": "GET", "path": "/api/v1/sessions/s-1/changes/file?path=..%2Fs-1.jsonl" }
    },
    {
      "name": "a file that did not change",
      "cli": { "args": ["session", "diff", "s-1", "other.txt"] }
    },
    {
      "name": "the session takes the ticket",
      "http": {
        "method": "POST",
        "path": "/api/v1/sessions/s-1/claim",
        "body": { "ticketKey": "ARC-1" }
      }
    },
    {
      "name": "the next start hands back the name",
      "cli": {
        "args": ["hook", "session-start"],
        "stdin": { "session_id": "s-1", "cwd": "{{WORK}}/arches", "source": "resume" }
      }
    },
    {
      "name": "a session without transcript",
      "cli": {
        "args": ["hook", "session-start"],
        "stdin": { "session_id": "s-2", "cwd": "{{WORK}}" }
      }
    },
    {
      "name": "its detail is empty",
      "http": { "method": "GET", "path": "/api/v1/sessions/s-2/detail" }
    }
  ]
}
