{
  "title": "Boards live in a project, keep their project until they are gone",
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": { "key": "ARC", "name": "Arches" }
      },
      "save": { "project": "json.id" }
    },
    {
      "name": "create",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": { "name": "  Main  " }
      },
      "save": { "board": "json.id" }
    },
    {
      "name": "blank name",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": { "name": " " }
      }
    },
    {
      "name": "unknown project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/0190a0b0-0000-7000-8000-00000000dead/boards",
        "body": { "name": "Lost" }
      }
    },
    { "name": "create in the CLI", "cli": { "args": ["board", "create", "arc", "Second"] } },
    {
      "name": "rename",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/projects/{{project}}/boards/{{board}}",
        "body": { "name": "Main 2", "version": 1 }
      }
    },
    {
      "name": "project with boards",
      "http": { "method": "DELETE", "path": "/api/v1/projects/{{project}}?version=1" }
    },
    { "name": "list in the CLI", "cli": { "args": ["board", "list", "--project", "ARC"] } },
    { "name": "delete in the CLI", "cli": { "args": ["board", "delete", "ARC", "{{board}}"] } },
    {
      "name": "list after delete",
      "http": { "method": "GET", "path": "/api/v1/projects/{{project}}/boards" }
    }
  ]
}
