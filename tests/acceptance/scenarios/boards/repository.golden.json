      "status": 201
    }
  },
  {
    "field": "items.0.local",
    "name": "the local runner",
    "reached": true,
    "wait": "/api/v1/runners"
  },
  {
    "name": "init a repository",
    "request": {
      "body": {
        "args": [
          "init",
          "-q",
          "arches"
        ],
        "cwd": "<WORK>",
        "label": "git init",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
      "path": "/api/v1/runs"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "error": null,
        "exitCode": null,
        "finishedAt": null,
        "id": "<ID-4>",
        "label": "git init",
        "startedAt": "<TIME>",
        "status": "running",
        "version": 2
      },
      "location": "/api/v1/runs/<ID-4>",
      "status": 201
    }
  },
  {
    "field": "status",
    "name": "initialized",
    "reached": "succeeded",
    "wait": "/api/v1/runs/<ID-4>"
  },
  {
    "cli": [
      "board",
      "repo",
      "<ID-2>"
    ],
    "exitCode": 0,
    "name": "no repository yet",
    "stderr": "",
    "stdout": "board <ID-2> has no repository\n"
  },
  {
    "name": "a folder outside any repository",
    "request": {
      "body": {
        "path": "<WORK>",
        "runnerId": "<ID-5>",
        "version": 1
      },
      "method": "PUT",
      "path": "/api/v1/projects/<ID-1>/boards/<ID-2>/repository"
    },
    "response": {
      "json": {
        "code": "not-a-git-project",
        "detail": "<WORK> is not inside a git repository",
        "status": 422,
        "title": "Unprocessable Entity",
        "type": "urn:nullradix:problem:not-a-git-project"
      },
      "status": 422
    }
  },
  {
    "name": "a relative path",
    "request": {
      "body": {
        "path": "arches",
        "runnerId": "<ID-5>",
        "version": 1
      },
      "method": "PUT",
      "path": "/api/v1/projects/<ID-1>/boards/<ID-2>/repository"
    },
    "response": {
      "json": {
        "code": "path-relative",
        "detail": "arches is not an absolute path",
        "status": 422,
        "title": "Unprocessable Entity",
        "type": "urn:nullradix:problem:path-relative"
      },
      "status": 422
    }
  },
  {
    "name": "an unknown runner",
    "request": {
      "body": {
        "path": "<WORK>/arches",
        "runnerId": "<ID-6>",
        "version": 1
      },
      "method": "PUT",
      "path": "/api/v1/projects/<ID-1>/boards/<ID-2>/repository"
    },
    "response": {
      "json": {
        "code": "runner-not-found",
        "detail": "runner <ID-6> does not exist",
        "status": 404,
        "title": "Not Found",
        "type": "urn:nullradix:problem:runner-not-found"
      },
      "status": 404
    }
  },
  {
    "name": "set",
    "request": {
      "body": {
        "path": "<WORK>/arches",
        "runnerId": "<ID-5>",
        "version": 1
      },
