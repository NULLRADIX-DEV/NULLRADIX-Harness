      "status": 200
    }
  },
  {
    "name": "stale version",
    "request": {
      "body": {
        "path": "<WORK>/arches",
        "runnerId": "<ID-5>",
        "version": 1
      },
      "method": "PUT",
      "path": "/api/v1/projects/<ID-1>/boards/<ID-2>/repository"
    },
    "response": {
      "json": {
        "code": "version-conflict",
        "detail": "board <ID-2> was changed by someone else, reload and try again",
        "status": 409,
        "title": "Conflict",
        "type": "urn:nullradix:problem:version-conflict"
      },
      "status": 409
    }
  },
  {
