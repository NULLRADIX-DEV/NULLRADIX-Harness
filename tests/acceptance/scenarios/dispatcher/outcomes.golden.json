  {
    "name": "first commit",
    "request": {
      "body": {
        "args": [
          "-c",
          "user.name=t",
          "-c",
          "user.email=t@example.com",
          "commit",
          "-q",
          "--allow-empty",
          "-m",
          "init"
        ],
        "cwd": "<WORK>/arches",
        "label": "git commit",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
      "path": "/api/v1/runs"
    },
