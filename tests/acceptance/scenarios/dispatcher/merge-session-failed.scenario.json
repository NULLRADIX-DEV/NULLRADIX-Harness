{
  "title": "Merge sessions that cannot resolve the conflict go up the ladder; the autopilot gives up after its limit and blocks the ticket",
  "env": {
    "FAKE_CLAUDE_MODE": "review",
    "FAKE_CLAUDE_MERGE": "fail",
    "GIT_AUTHOR_NAME": "t",
    "GIT_AUTHOR_EMAIL": "t@example.com",
    "GIT_COMMITTER_NAME": "t",
    "GIT_COMMITTER_EMAIL": "t@example.com"
  },
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": {
          "key": "ARC",
          "name": "Arches"
        }
      },
      "save": {
        "project": "json.id"
      }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": {
          "name": "Main"
        }
      },
      "save": {
        "board": "json.id"
      }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "init": "json.id"
      }
    },
    {
      "name": "initialized",
      "wait": {
        "path": "/api/v1/runs/{{init}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the readme",
      "file": {
        "path": "{{WORK}}/arches/README.md",
        "text": "# Arches\n"
      }
    },
    {
      "name": "the price module",
      "file": {
        "path": "{{WORK}}/arches/src/price.ts",
        "text": "export const price = (net: number) => net;\n"
      }
    },
    {
      "name": "a module that goes away",
      "file": {
        "path": "{{WORK}}/arches/src/old.ts",
        "text": "export const OLD = true;\n"
      }
    },
    {
      "name": "a note that moves",
      "file": {
        "path": "{{WORK}}/arches/docs/note.md",
        "text": "The prices\nare in\nsrc/price.ts\nand nowhere else\nat all.\n"
      }
    },
    {
      "name": "stage the files",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git add",
          "program": "git",
          "args": ["add", "-A"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "add": "json.id"
      }
    },
    {
      "name": "staged",
      "wait": {
        "path": "/api/v1/runs/{{add}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "first commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git commit",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "-c",
            "commit.gpgsign=false",
            "commit",
            "-q",
            "-m",
            "init"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "commit": "json.id"
      }
    },
    {
      "name": "committed",
      "wait": {
        "path": "/api/v1/runs/{{commit}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "long paths on already, so every platform prints the same",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git config",
          "program": "git",
          "args": ["config", "core.longpaths", "true"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "config": "json.id"
      }
    },
    {
      "name": "configured",
      "wait": {
        "path": "/api/v1/runs/{{config}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "bind the board",
      "cli": {
        "args": ["board", "repo", "{{board}}", "{{WORK}}/arches"]
      }
    },
    {
      "name": "a ready ticket",
      "cli": {
        "args": [
          "ticket",
          "create",
          "Build the discount",
          "--board",
          "{{board}}",
          "--label",
          "auto",
          "--acceptance",
          "The price drops by the discount",
          "--planned"
        ]
      }
    },
    {
      "name": "a ticket the dispatcher never takes",
      "cli": {
        "args": ["ticket", "create", "Check the shipping", "--board", "{{board}}"]
      }
    },
    {
      "name": "plan the first",
      "cli": {
        "args": ["plan", "write", "ARC-1", "--plan", "Apply it", "--handbook", "npx vitest run"]
      }
    },
    {
      "name": "the configuration",
      "file": {
        "path": "{{WORK}}/config.json",
        "lines": [
          {
            "reviewBeforeMerge": false,
            "autopilot": {
              "enabled": true,
              "exceptLabel": "interactive",
              "maxMergeSessions": 2
            }
          }
        ]
      }
    },
    {
      "name": "save the configuration",
      "cli": {
        "args": ["dispatcher", "config", "set", "--file", "{{WORK}}/config.json"]
      }
    },
    {
      "name": "switch on",
      "cli": {
        "args": ["dispatcher", "enable"]
      }
    },
    {
      "name": "a pass starts the ticket",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "the run ended",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work",
        "field": "items.0.status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the agent finishes its ticket",
      "cli": {
        "args": [
          "ticket",
          "move",
          "ARC-1",
          "done",
          "--acceptance",
          "The price drops by the discount",
          "--author",
          "worker-ARC-0001"
        ]
      }
    },
    {
      "name": "main changes the price too",
      "file": {
        "path": "{{WORK}}/arches/src/price.ts",
        "text": "export const price = (net: number) => net * 2;\n"
      }
    },
    {
      "name": "stage the change on main",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git add",
          "program": "git",
          "args": ["add", "-A"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "stageMain": "json.id"
      }
    },
    {
      "name": "stage the change on main finished",
      "wait": {
        "path": "/api/v1/runs/{{stageMain}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "commit the change on main",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git -c",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "-c",
            "commit.gpgsign=false",
            "commit",
            "-q",
            "-m",
            "Double the price on main"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "commitMain": "json.id"
      }
    },
    {
      "name": "commit the change on main finished",
      "wait": {
        "path": "/api/v1/runs/{{commitMain}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the next pass meets the conflict and starts the first session",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "the first session",
      "http": {
        "method": "GET",
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=merge"
      }
    },
    {
      "name": "the first session failed",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=merge",
        "field": "items.0.status",
        "equals": "failed"
      }
    },
    {
      "name": "the next pass counts the failure and starts the second session one step higher",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "both sessions",
      "http": {
        "method": "GET",
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=merge"
      }
    },
    {
      "name": "the merge waits for the second session",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1/merges"
      }
    },
    {
      "name": "the second session failed",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=merge",
        "field": "items.0.status",
        "equals": "failed"
      }
    },
    {
      "name": "the next pass reaches the limit and blocks the ticket",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "the ticket is blocked by the merge",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1"
      }
    },
    {
      "name": "the merge failed",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1/merges"
      }
    },
    {
      "name": "both sessions are settled",
      "http": {
        "method": "GET",
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=merge"
      }
    },
    {
      "name": "the inbox shows the merge problem",
      "cli": {
        "args": ["inbox", "--kind", "merge"]
      }
    },
    {
      "name": "a failed merge starts nothing again",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "still two sessions",
      "http": {
        "method": "GET",
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=merge"
      }
    }
  ]
}
