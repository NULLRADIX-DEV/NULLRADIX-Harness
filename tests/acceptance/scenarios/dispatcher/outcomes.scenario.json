{
  "title": "Finished runs are settled as done and blocked and the agent commands are attributed to the run",
  "env": { "FAKE_CLAUDE_MODE": "cwd" },
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": { "key": "ARC", "name": "Arches" }
      },
      "save": { "project": "json.id" }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": { "name": "Main" }
      },
      "save": { "board": "json.id" }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": { "init": "json.id" }
    },
    {
      "name": "initialized",
      "wait": { "path": "/api/v1/runs/{{init}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "first commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git commit",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "commit",
            "-q",
            "--allow-empty",
            "-m",
            "init"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "commit": "json.id" }
    },
    {
      "name": "committed",
      "wait": { "path": "/api/v1/runs/{{commit}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "long paths on already, so every platform prints the same",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git config",
          "program": "git",
          "args": ["config", "core.longpaths", "true"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "config": "json.id" }
    },
    {
      "name": "configured",
      "wait": { "path": "/api/v1/runs/{{config}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "bind the board",
      "cli": { "args": ["board", "repo", "{{board}}", "{{WORK}}/arches"] }
    },
    {
      "name": "a ready ticket",
      "cli": {
        "args": [
          "ticket",
          "create",
          "Build the login",
          "--board",
          "{{board}}",
          "--label",
          "auto",
          "--acceptance",
          "Login works",
          "--planned"
        ]
      }
    },
    {
      "name": "a second ready ticket",
      "cli": {
        "args": [
          "ticket",
          "create",
          "Write the docs",
          "--board",
          "{{board}}",
          "--label",
          "auto",
          "--acceptance",
          "Docs exist",
          "--planned"
        ]
      }
    },
    {
      "name": "plan the first",
      "cli": {
        "args": ["plan", "write", "ARC-1", "--plan", "Build it", "--handbook", "cargo test"]
      }
    },
    {
      "name": "plan the second",
      "cli": {
        "args": ["plan", "write", "ARC-2", "--plan", "Write it", "--handbook", "cargo test"]
      }
    },
    { "name": "switch on", "cli": { "args": ["dispatcher", "enable"] } },
    { "name": "a pass starts the first ticket", "cli": { "args": ["dispatcher", "run"] } },
    {
      "name": "the first run ended",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work",
        "field": "items.0.status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the agent finishes its ticket",
      "cli": {
        "args": [
          "ticket",
          "move",
          "ARC-1",
          "done",
          "--acceptance",
          "Login works",
          "--author",
          "worker-ARC-0001"
        ]
      }
    },
    {
      "name": "the next pass settles the first run and starts the second ticket",
      "cli": { "args": ["dispatcher", "run"] }
    },
    {
      "name": "the second run ended",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-0002&kind=work",
        "field": "items.0.status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the agent reports that it is blocked",
      "cli": {
        "args": [
          "ticket",
          "set",
          "ARC-2",
          "--status",
          "blocked",
          "--blocked-reason",
          "No access to the docs server",
          "--author",
          "worker-ARC-0002"
        ]
      }
    },
    { "name": "the next pass settles the second run", "cli": { "args": ["dispatcher", "run"] } },
    {
      "name": "the first run is done",
      "http": { "method": "GET", "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work" }
    },
    {
      "name": "the second run is blocked",
      "http": { "method": "GET", "path": "/api/v1/runs?ticketKey=ARC-0002&kind=work" }
    },
    {
      "name": "the first ticket and who changed it",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1" }
    },
    {
      "name": "the second ticket stays blocked with its agent",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-2" }
    }
  ]
}
