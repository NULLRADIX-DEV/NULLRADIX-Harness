{
  "title": "A refused merge shows in the inbox, and a retry merges the branch once the cause is fixed",
  "env": {
    "FAKE_CLAUDE_MODE": "review",
    "GIT_AUTHOR_NAME": "t",
    "GIT_AUTHOR_EMAIL": "t@example.com",
    "GIT_COMMITTER_NAME": "t",
    "GIT_COMMITTER_EMAIL": "t@example.com"
  },
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": {
          "key": "ARC",
          "name": "Arches"
        }
      },
      "save": {
        "project": "json.id"
      }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": {
          "name": "Main"
        }
      },
      "save": {
        "board": "json.id"
      }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "init": "json.id"
      }
    },
    {
      "name": "initialized",
      "wait": {
        "path": "/api/v1/runs/{{init}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the readme",
      "file": {
        "path": "{{WORK}}/arches/README.md",
        "text": "# Arches\n"
      }
    },
    {
      "name": "the price module",
      "file": {
        "path": "{{WORK}}/arches/src/price.ts",
        "text": "export const price = (net: number) => net;\n"
      }
    },
    {
      "name": "a module that goes away",
      "file": {
        "path": "{{WORK}}/arches/src/old.ts",
        "text": "export const OLD = true;\n"
      }
    },
    {
      "name": "a note that moves",
      "file": {
        "path": "{{WORK}}/arches/docs/note.md",
        "text": "The prices\nare in\nsrc/price.ts\nand nowhere else\nat all.\n"
      }
    },
    {
      "name": "stage the files",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git add",
          "program": "git",
          "args": ["add", "-A"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "add": "json.id"
      }
    },
    {
      "name": "staged",
      "wait": {
        "path": "/api/v1/runs/{{add}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "first commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git commit",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "-c",
            "commit.gpgsign=false",
            "commit",
            "-q",
            "-m",
            "init"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "commit": "json.id"
      }
    },
    {
      "name": "committed",
      "wait": {
        "path": "/api/v1/runs/{{commit}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "long paths on already, so every platform prints the same",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git config",
          "program": "git",
          "args": ["config", "core.longpaths", "true"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "config": "json.id"
      }
    },
    {
      "name": "configured",
      "wait": {
        "path": "/api/v1/runs/{{config}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "bind the board",
      "cli": {
        "args": ["board", "repo", "{{board}}", "{{WORK}}/arches"]
      }
    },
    {
      "name": "a ready ticket",
      "cli": {
        "args": [
          "ticket",
          "create",
          "Build the discount",
          "--board",
          "{{board}}",
          "--label",
          "auto",
          "--acceptance",
          "The price drops by the discount",
          "--planned"
        ]
      }
    },
    {
      "name": "a ticket the dispatcher never takes",
      "cli": {
        "args": ["ticket", "create", "Check the shipping", "--board", "{{board}}"]
      }
    },
    {
      "name": "plan the first",
      "cli": {
        "args": ["plan", "write", "ARC-1", "--plan", "Apply it", "--handbook", "npx vitest run"]
      }
    },
    {
      "name": "switch on",
      "cli": {
        "args": ["dispatcher", "enable"]
      }
    },
    {
      "name": "a pass starts the ticket",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "the run ended",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work",
        "field": "items.0.status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the agent finishes its ticket",
      "cli": {
        "args": [
          "ticket",
          "move",
          "ARC-1",
          "done",
          "--acceptance",
          "The price drops by the discount",
          "--author",
          "worker-ARC-0001"
        ]
      }
    },
    {
      "name": "the next pass holds the finished ticket for review",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "the ticket waits for a person",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1"
      }
    },
    {
      "name": "a pass merges nothing yet",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "accept the held ticket",
      "cli": {
        "args": ["ticket", "accept", "ARC-1"]
      }
    },
    {
      "name": "detach the main checkout",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git checkout",
          "program": "git",
          "args": ["checkout", "-q", "--detach"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "detach": "json.id"
      }
    },
    {
      "name": "detach the main checkout finished",
      "wait": {
        "path": "/api/v1/runs/{{detach}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the next pass cannot merge",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "the ticket is blocked with the merge problem",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1"
      }
    },
    {
      "name": "the inbox has a merge entry with the problem",
      "cli": {
        "args": ["inbox", "--kind", "merge"]
      }
    },
    {
      "name": "the merge failed",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1/merges"
      }
    },
    {
      "name": "a retry while the checkout is still detached",
      "cli": {
        "args": ["ticket", "merge", "ARC-1"]
      }
    },
    {
      "name": "it is blocked again",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1"
      }
    },
    {
      "name": "fix the checkout",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git checkout",
          "program": "git",
          "args": ["checkout", "-q", "main"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "fix": "json.id"
      }
    },
    {
      "name": "fix the checkout finished",
      "wait": {
        "path": "/api/v1/runs/{{fix}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "a retry merges the branch",
      "cli": {
        "args": ["ticket", "merge", "ARC-1"]
      }
    },
    {
      "name": "the ticket is done and its branch is cleared",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1"
      }
    },
    {
      "name": "the merges, newest first",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1/merges"
      }
    },
    {
      "name": "the inbox is empty again",
      "cli": {
        "args": ["inbox"]
      }
    },
    {
      "name": "a ticket that waits for no merge is refused",
      "cli": {
        "args": ["ticket", "merge", "ARC-1"]
      }
    },
    {
      "name": "an unknown ticket",
      "http": {
        "method": "POST",
        "path": "/api/v1/tickets/ARC-99/merge",
        "body": {}
      }
    },
    {
      "name": "a ticket that never started",
      "http": {
        "method": "POST",
        "path": "/api/v1/tickets/ARC-2/merge",
        "body": {}
      }
    },
    {
      "name": "the main commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git log",
          "program": "git",
          "args": ["log", "-1", "--format=%s", "--first-parent"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "subject": "json.id"
      }
    },
    {
      "name": "the main commit finished",
      "wait": {
        "path": "/api/v1/runs/{{subject}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the main commit printed",
      "http": {
        "method": "GET",
        "path": "/api/v1/runs/{{subject}}/output"
      }
    }
  ]
}
