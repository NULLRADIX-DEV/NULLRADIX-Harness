{
  "title": "A dispatcher pass claims a ready ticket and the fake Claude starts in its worktree",
  "env": { "FAKE_CLAUDE_MODE": "cwd" },
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": { "key": "ARC", "name": "Arches" }
      },
      "save": { "project": "json.id" }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": { "name": "Main" }
      },
      "save": { "board": "json.id" }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": { "init": "json.id" }
    },
    {
      "name": "initialized",
      "wait": { "path": "/api/v1/runs/{{init}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "first commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git commit",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "commit",
            "-q",
            "--allow-empty",
            "-m",
            "init"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "commit": "json.id" }
    },
    {
      "name": "committed",
      "wait": { "path": "/api/v1/runs/{{commit}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "long paths on already, so every platform prints the same",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git config",
          "program": "git",
          "args": ["config", "core.longpaths", "true"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "config": "json.id" }
    },
    {
      "name": "configured",
      "wait": { "path": "/api/v1/runs/{{config}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "bind the board",
      "cli": { "args": ["board", "repo", "{{board}}", "{{WORK}}/arches"] }
    },
    {
      "name": "a ready ticket",
      "cli": {
        "args": [
          "ticket",
          "create",
          "Build the login",
          "--board",
          "{{board}}",
          "--label",
          "auto",
          "--acceptance",
          "Login works",
          "--planned"
        ]
      }
    },
    {
      "name": "a ticket without the opt-in label",
      "cli": {
        "args": [
          "ticket",
          "create",
          "Write the docs",
          "--board",
          "{{board}}",
          "--acceptance",
          "Docs exist",
          "--planned"
        ]
      }
    },
    {
      "name": "plan the first",
      "cli": {
        "args": ["plan", "write", "ARC-1", "--plan", "Build it", "--handbook", "cargo test"]
      }
    },
    {
      "name": "plan the second",
      "cli": {
        "args": ["plan", "write", "ARC-2", "--plan", "Write it", "--handbook", "cargo test"]
      }
    },
    { "name": "the dispatcher is off", "cli": { "args": ["dispatcher", "status"] } },
    { "name": "a pass while off starts nothing", "cli": { "args": ["dispatcher", "run"] } },
    { "name": "switch on", "cli": { "args": ["dispatcher", "enable"] } },
    { "name": "a pass starts the ready ticket", "cli": { "args": ["dispatcher", "run"] } },
    {
      "name": "the fake Claude ended",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work",
        "field": "items.0.status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the run started in the worktree of the ticket",
      "http": { "method": "GET", "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work" },
      "save": { "run": "json.items.0.id" }
    },
    {
      "name": "what the fake Claude saw",
      "http": { "method": "GET", "path": "/api/v1/runs/{{run}}/output" }
    },
    {
      "name": "the ticket is claimed and in progress",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1" }
    },
    {
      "name": "the state after the pass",
      "http": { "method": "GET", "path": "/api/v1/dispatcher" }
    }
  ]
}
