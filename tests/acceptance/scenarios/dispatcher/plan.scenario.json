{
  "title": "Planning of tickets by hand and by the automation: start, refusals, a saved plan, a run that left none",
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": { "key": "ARC", "name": "Arches" }
      },
      "save": { "project": "json.id" }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": { "name": "Main" }
      },
      "save": { "board": "json.id" }
    },
    {
      "name": "a project whose board has no repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": { "key": "OTH", "name": "Others" }
      },
      "save": { "other": "json.id" }
    },
    {
      "name": "its board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{other}}/boards",
        "body": { "name": "Bare" }
      },
      "save": { "bare": "json.id" }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": { "init": "json.id" }
    },
    {
      "name": "initialized",
      "wait": { "path": "/api/v1/runs/{{init}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "first commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git commit",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "commit",
            "-q",
            "--allow-empty",
            "-m",
            "init"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "commit": "json.id" }
    },
    {
      "name": "committed",
      "wait": { "path": "/api/v1/runs/{{commit}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "long paths on already, so every platform prints the same",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git config",
          "program": "git",
          "args": ["config", "core.longpaths", "true"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "config": "json.id" }
    },
    {
      "name": "configured",
      "wait": { "path": "/api/v1/runs/{{config}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "bind the board",
      "cli": { "args": ["board", "repo", "{{board}}", "{{WORK}}/arches"] }
    },
    {
      "name": "a ticket that needs planning",
      "cli": {
        "args": [
          "ticket",
          "create",
          "Add the discount",
          "--board",
          "{{board}}",
          "--acceptance",
          "The price drops by the discount"
        ]
      }
    },
    {
      "name": "a ticket that is done already",
      "cli": {
        "args": [
          "ticket",
          "create",
          "Check the shipping",
          "--board",
          "{{board}}",
          "--status",
          "done",
          "--acceptance",
          "The shipping costs are right"
        ]
      }
    },
    {
      "name": "a ticket that waits on a question",
      "cli": { "args": ["ticket", "create", "Redeem the voucher", "--board", "{{board}}"] }
    },
    {
      "name": "the open question",
      "cli": {
        "args": [
          "question",
          "add",
          "Does the voucher apply to shipping too?",
          "--project",
          "ARC",
          "--ticket",
          "ARC-3"
        ]
      }
    },
    {
      "name": "a ticket for the failure paths",
      "cli": { "args": ["ticket", "create", "Round the price", "--board", "{{board}}"] }
    },
    {
      "name": "a ticket of the board without a repository",
      "cli": { "args": ["ticket", "create", "Nowhere to plan", "--board", "{{bare}}"] }
    },
    {
      "name": "plan an unknown ticket",
      "http": { "method": "POST", "path": "/api/v1/tickets/ARC-99/plan-runs", "body": {} }
    },
    {
      "name": "plan something that is no ticket key",
      "http": { "method": "POST", "path": "/api/v1/tickets/ARC-Q1/plan-runs", "body": {} }
    },
    {
      "name": "plan a ticket that is done",
      "http": { "method": "POST", "path": "/api/v1/tickets/ARC-2/plan-runs", "body": {} }
    },
    {
      "name": "plan a ticket that waits on a question",
      "http": { "method": "POST", "path": "/api/v1/tickets/ARC-3/plan-runs", "body": {} }
    },
    {
      "name": "plan a ticket of a board without a repository",
      "http": { "method": "POST", "path": "/api/v1/tickets/OTH-1/plan-runs", "body": {} }
    },
    {
      "name": "the state before the planning",
      "http": { "method": "GET", "path": "/api/v1/runs?ticketKey=ARC-1&kind=plan" }
    },
    {
      "name": "start the planning by hand, the dispatcher being off",
      "cli": { "args": ["plan", "start", "arc-1"] }
    },
    {
      "name": "the run is there",
      "http": { "method": "GET", "path": "/api/v1/runs?ticketKey=ARC-1&kind=plan" }
    },
    {
      "name": "the ticket is claimed for the planner",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1" }
    },
    {
      "name": "the run ended",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-1&kind=plan",
        "field": "items.0.status",
        "equals": "succeeded"
      }
    },
    {
      "name": "start it a second time while the first is not settled",
      "http": { "method": "POST", "path": "/api/v1/tickets/ARC-1/plan-runs", "body": {} }
    },
    {
      "name": "a pause holds a planning back",
      "cli": { "args": ["dispatcher", "pause", "--minutes", "30"] }
    },
    {
      "name": "planning during the pause",
      "http": { "method": "POST", "path": "/api/v1/tickets/ARC-4/plan-runs", "body": {} }
    },
    { "name": "lift the pause", "cli": { "args": ["dispatcher", "resume"] } },
    {
      "name": "the plan file the agent writes",
      "file": {
        "path": "{{WORK}}/plan.json",
        "text": "{\"plan\":\"Apply the discount in the price function.\\n\\n## Effort\\nsmall - one function\",\"handbook\":\"npx vitest run\",\"diagram\":\"graph TD\\n  A-->B\",\"acceptance\":\"The price drops by the discount.\"}"
      }
    },
    {
      "name": "the agent saves it",
      "cli": {
        "args": [
          "plan",
          "import",
          "ARC-1",
          "--file",
          "{{WORK}}/plan.json",
          "--author",
          "planner-ARC-0001"
        ]
      }
    },
    { "name": "a pass settles the run", "cli": { "args": ["dispatcher", "run"] } },
    {
      "name": "the run with its outcome",
      "http": { "method": "GET", "path": "/api/v1/runs?ticketKey=ARC-1&kind=plan" }
    },
    {
      "name": "the ticket with the plan",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1" }
    },
    {
      "name": "the plan in the CLI",
      "cli": { "args": ["ticket", "show", "ARC-1"] }
    },
    {
      "name": "the planning folder is gone, only the main folder is left",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git worktree list",
          "program": "git",
          "args": ["worktree", "list", "--porcelain"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "listing": "json.id" }
    },
    {
      "name": "listed",
      "wait": { "path": "/api/v1/runs/{{listing}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "the list",
      "http": { "method": "GET", "path": "/api/v1/runs/{{listing}}/output" }
    },
    {
      "name": "plan the fourth ticket, which stays without a result",
      "http": { "method": "POST", "path": "/api/v1/tickets/ARC-4/plan-runs", "body": {} }
    },
    {
      "name": "the second run ended",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-4&kind=plan",
        "field": "items.0.status",
        "equals": "succeeded"
      }
    },
    { "name": "a pass settles it", "cli": { "args": ["dispatcher", "run"] } },
    {
      "name": "the run is settled",
      "http": { "method": "GET", "path": "/api/v1/runs?ticketKey=ARC-4&kind=plan" }
    },
    {
      "name": "the ticket says so and still needs planning",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-4/comments" }
    },
    {
      "name": "the claim is given back",
      "cli": { "args": ["plan", "next", "--project", "ARC"] }
    },
    {
      "name": "a plan without anything is refused",
      "http": { "method": "PUT", "path": "/api/v1/tickets/ARC-4/plan", "body": {} }
    },
    {
      "name": "a plan file with a field that is no text is refused",
      "file": { "path": "{{WORK}}/broken.json", "text": "{\"plan\":7}" }
    },
    {
      "name": "the broken file is refused",
      "cli": { "args": ["plan", "import", "ARC-4", "--file", "{{WORK}}/broken.json"] }
    },
    {
      "name": "the automation takes up only tickets that come after it is switched on",
      "file": {
        "path": "{{WORK}}/auto.json",
        "lines": [{ "planning": { "auto": true, "wip": 2 } }]
      }
    },
    {
      "name": "switch it on",
      "cli": { "args": ["dispatcher", "config", "set", "--file", "{{WORK}}/auto.json"] }
    },
    {
      "name": "a pass starts nothing, the open tickets are older",
      "cli": { "args": ["dispatcher", "run"] }
    },
    {
      "name": "a new ticket",
      "cli": { "args": ["ticket", "create", "Print the invoice", "--board", "{{board}}"] }
    },
    { "name": "a pass starts its planning", "cli": { "args": ["dispatcher", "run"] } },
    {
      "name": "the run of the new ticket",
      "http": { "method": "GET", "path": "/api/v1/runs?ticketKey=ARC-5&kind=plan" }
    },
    {
      "name": "the older ticket was left alone",
      "http": { "method": "GET", "path": "/api/v1/runs?ticketKey=ARC-4&kind=plan" }
    }
  ]
}
