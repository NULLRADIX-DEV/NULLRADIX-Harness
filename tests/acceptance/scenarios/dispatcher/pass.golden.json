[
  {
    "name": "project",
    "request": {
      "body": {
        "key": "ARC",
        "name": "Arches"
      },
      "method": "POST",
      "path": "/api/v1/projects"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "id": "<ID-1>",
        "key": "ARC",
        "name": "Arches",
        "updatedAt": "<TIME>",
        "version": 1
      },
      "location": "/api/v1/projects/<ID-1>",
      "status": 201
    }
  },
  {
    "name": "board",
    "request": {
      "body": {
        "name": "Main"
      },
      "method": "POST",
      "path": "/api/v1/projects/<ID-1>/boards"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "dispatchEnabled": true,
        "id": "<ID-2>",
        "name": "Main",
        "openTickets": 0,
        "ownerId": "<ID-3>",
        "ownerName": "tester",
        "projectId": "<ID-1>",
        "projectKey": "ARC",
        "repositoryId": null,
        "repositoryName": null,
        "updatedAt": "<TIME>",
        "version": 1
      },
      "location": "/api/v1/projects/<ID-1>/boards/<ID-2>",
      "status": 201
    }
  },
  {
    "name": "init a repository",
    "request": {
      "body": {
        "args": [
          "init",
          "-q",
          "-b",
          "main",
          "arches"
        ],
        "cwd": "<WORK>",
        "label": "git init",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
      "path": "/api/v1/runs"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "dispatch": null,
        "error": null,
        "exitCode": null,
        "finishedAt": null,
        "id": "<ID-4>",
        "label": "git init",
        "result": null,
        "startedAt": "<TIME>",
        "status": "running",
        "version": 2
      },
      "location": "/api/v1/runs/<ID-4>",
      "status": 201
    }
  },
  {
    "field": "status",
    "name": "initialized",
    "reached": "succeeded",
    "wait": "/api/v1/runs/<ID-4>"
  },
  {
    "name": "first commit",
    "request": {
      "body": {
        "args": [
          "-c",
          "user.name=t",
          "-c",
          "user.email=t@example.com",
          "commit",
          "-q",
          "--allow-empty",
          "-m",
          "init"
        ],
        "cwd": "<WORK>/arches",
        "label": "git commit",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
      "path": "/api/v1/runs"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "dispatch": null,
        "error": null,
        "exitCode": null,
        "finishedAt": null,
        "id": "<ID-5>",
        "label": "git commit",
        "result": null,
        "startedAt": "<TIME>",
        "status": "running",
        "version": 2
      },
      "location": "/api/v1/runs/<ID-5>",
      "status": 201
    }
  },
  {
    "field": "status",
    "name": "committed",
    "reached": "succeeded",
    "wait": "/api/v1/runs/<ID-5>"
  },
  {
    "name": "long paths on already, so every platform prints the same",
    "request": {
      "body": {
        "args": [
          "config",
          "core.longpaths",
          "true"
        ],
        "cwd": "<WORK>/arches",
        "label": "git config",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
      "path": "/api/v1/runs"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "dispatch": null,
        "error": null,
        "exitCode": null,
        "finishedAt": null,
        "id": "<ID-6>",
        "label": "git config",
        "result": null,
        "startedAt": "<TIME>",
        "status": "running",
        "version": 2
      },
      "location": "/api/v1/runs/<ID-6>",
      "status": 201
    }
  },
  {
    "field": "status",
    "name": "configured",
    "reached": "succeeded",
    "wait": "/api/v1/runs/<ID-6>"
  },
  {
    "cli": [
      "board",
      "repo",
      "<ID-2>",
      "<WORK>/arches"
    ],
    "exitCode": 0,
    "name": "bind the board",
    "stderr": "",
    "stdout": "board <ID-2> works in arches at <WORK>/arches\n"
  },
  {
    "cli": [
      "ticket",
      "create",
      "Build the login",
      "--board",
      "<ID-2>",
      "--label",
      "auto",
      "--acceptance",
      "Login works",
      "--planned"
    ],
    "exitCode": 0,
    "name": "a ready ticket",
    "stderr": "",
    "stdout": "ARC-0001 created: Build the login\n"
  },
  {
    "cli": [
      "ticket",
      "create",
      "Write the docs",
      "--board",
      "<ID-2>",
      "--acceptance",
      "Docs exist",
      "--planned"
    ],
    "exitCode": 0,
    "name": "a ticket without the opt-in label",
    "stderr": "",
    "stdout": "ARC-0002 created: Write the docs\n"
  },
  {
    "cli": [
      "plan",
      "write",
      "ARC-1",
      "--plan",
      "Build it",
      "--handbook",
      "cargo test"
    ],
    "exitCode": 0,
    "name": "plan the first",
    "stderr": "",
    "stdout": "ARC-0001 planned (planned)\n"
  },
  {
    "cli": [
      "plan",
      "write",
      "ARC-2",
      "--plan",
      "Write it",
      "--handbook",
      "cargo test"
    ],
    "exitCode": 0,
    "name": "plan the second",
    "stderr": "",
    "stdout": "ARC-0002 planned (planned)\n"
  },
  {
    "cli": [
      "dispatcher",
      "status"
    ],
    "exitCode": 0,
    "name": "the dispatcher is off",
    "stderr": "",
    "stdout": "off: The dispatcher is off\n0 of 1 places in use, 0 planning\n  ARC-0001 Build the login: ready\n  ARC-0002 Write the docs: label \"auto\" is missing\n"
  },
  {
    "cli": [
      "dispatcher",
      "run"
    ],
    "exitCode": 0,
    "name": "a pass while off starts nothing",
    "stderr": "",
    "stdout": "idle: The dispatcher is off\n"
  },
  {
    "cli": [
      "dispatcher",
      "enable"
    ],
    "exitCode": 0,
    "name": "switch on",
    "stderr": "",
    "stdout": "idle: Idle\n0 of 1 places in use, 0 planning\n  ARC-0001 Build the login: ready\n  ARC-0002 Write the docs: label \"auto\" is missing\n"
  },
  {
    "cli": [
      "dispatcher",
      "run"
    ],
    "exitCode": 0,
    "name": "a pass starts the ready ticket",
    "stderr": "",
    "stdout": "started: ARC-0001\n"
  },
