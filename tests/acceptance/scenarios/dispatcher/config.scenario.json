{
  "title": "The dispatcher configuration is read, changed from the CLI, refused field by field and checked against accounts",
  "steps": [
    { "name": "show the default in the CLI", "cli": { "args": ["dispatcher", "config", "show"] } },
    {
      "name": "read the default over HTTP",
      "http": { "method": "GET", "path": "/api/v1/dispatcher/config" }
    },
    {
      "name": "show the default as JSON",
      "cli": { "args": ["dispatcher", "config", "show", "--json"] }
    },
    {
      "name": "save the same value",
      "cli": { "args": ["dispatcher", "config", "set", "--enabled", "false"] }
    },
    {
      "name": "switch on with two tickets at once",
      "cli": { "args": ["dispatcher", "config", "set", "--enabled", "true", "--wip", "2"] }
    },
    {
      "name": "write a custom configuration",
      "file": {
        "path": "{{WORK}}/custom.json",
        "lines": [
          {
            "window": { "from": "08:00", "to": "18:00" },
            "optInLabel": null,
            "optOutLabel": "manual",
            "maxAttempts": 3,
            "profiles": [
              {
                "name": "small",
                "model": "sonnet",
                "effort": "high",
                "maxTurns": 40,
                "timeoutMinutes": 45,
                "accounts": []
              },
              {
                "name": "medium",
                "model": "opus",
                "effort": "high",
                "maxTurns": 80,
                "timeoutMinutes": 90,
                "accounts": []
              }
            ],
            "defaultProfile": "small",
            "ladder": ["small", "medium"],
            "rules": [
              { "when": { "labels": ["architecture"] }, "profile": "medium", "accounts": [] }
            ],
            "research": { "auto": false, "wip": 2, "maxPerDay": 5, "profile": null },
            "planning": { "auto": false, "wip": 1, "acceptance": false, "profile": null },
            "claude": { "command": "claude", "model": "sonnet", "permissionMode": "acceptEdits" }
          }
        ]
      }
    },
    {
      "name": "save the custom configuration",
      "cli": { "args": ["dispatcher", "config", "set", "--file", "{{WORK}}/custom.json"] }
    },
    {
      "name": "read the saved configuration",
      "http": { "method": "GET", "path": "/api/v1/dispatcher/config" }
    },
    { "name": "show the saved configuration", "cli": { "args": ["dispatcher", "config", "show"] } },
    {
      "name": "refuse a negative WIP",
      "cli": { "args": ["dispatcher", "config", "set", "--wip=-1"] }
    },
    {
      "name": "write an unknown default profile",
      "file": { "path": "{{WORK}}/giant.json", "lines": [{ "defaultProfile": "giant" }] }
    },
    {
      "name": "refuse an unknown default profile",
      "cli": { "args": ["dispatcher", "config", "set", "--file", "{{WORK}}/giant.json"] }
    },
    {
      "name": "write too many research runs",
      "file": { "path": "{{WORK}}/research.json", "lines": [{ "research": { "wip": 6 } }] }
    },
    {
      "name": "refuse too many research runs",
      "cli": { "args": ["dispatcher", "config", "set", "--file", "{{WORK}}/research.json"] }
    },
    {
      "name": "write a broken window",
      "file": {
        "path": "{{WORK}}/window.json",
        "lines": [{ "window": { "from": "25:00", "to": "18:00" } }]
      }
    },
    {
      "name": "refuse a broken window",
      "cli": { "args": ["dispatcher", "config", "set", "--file", "{{WORK}}/window.json"] }
    },
    {
      "name": "write several mistakes",
      "file": {
        "path": "{{WORK}}/many.json",
        "lines": [
          {
            "maxAttempts": 0,
            "accountLimitPercent": 20,
            "ladder": ["small", "ghost", "small"],
            "rules": [{ "when": {}, "profile": "medium", "accounts": [] }],
            "worktreeSetup": [{ "cwd": "../outside", "run": "npm ci" }]
          }
        ]
      }
    },
    {
      "name": "refuse every mistake at once",
      "cli": { "args": ["dispatcher", "config", "set", "--file", "{{WORK}}/many.json"] }
    },
    {
      "name": "write a rule for an unknown account",
      "file": {
        "path": "{{WORK}}/ghost.json",
        "lines": [
          { "rules": [{ "when": { "filesMin": 1 }, "profile": "small", "accounts": ["ghost"] }] }
        ]
      }
    },
    {
      "name": "refuse an unknown account",
      "cli": { "args": ["dispatcher", "config", "set", "--file", "{{WORK}}/ghost.json"] }
    },
    {
      "name": "refuse an unknown field in the file",
      "file": { "path": "{{WORK}}/typo.json", "lines": [{ "wipp": 3 }] }
    },
    {
      "name": "refuse a misspelled setting",
      "cli": { "args": ["dispatcher", "config", "set", "--file", "{{WORK}}/typo.json"] }
    },
    {
      "name": "write another Claude command",
      "file": {
        "path": "{{WORK}}/command.json",
        "lines": [
          {
            "claude": { "command": "/opt/claude" },
            "worktreeSetup": [{ "cwd": ".", "run": "npm ci" }]
          }
        ]
      }
    },
    {
      "name": "refuse a token changing what runs as a command",
      "cli": { "args": ["dispatcher", "config", "set", "--file", "{{WORK}}/command.json"] }
    },
    {
      "name": "read the configuration the refusal left alone",
      "http": { "method": "GET", "path": "/api/v1/dispatcher/config" }
    },
    { "name": "show after the refusals", "cli": { "args": ["dispatcher", "config", "show"] } },
    { "name": "ask for nothing", "cli": { "args": ["dispatcher", "config", "set"] } },
    {
      "name": "refuse a body without the configuration",
      "http": {
        "method": "PUT",
        "path": "/api/v1/dispatcher/config",
        "body": { "version": 2, "config": {} }
      }
    },
    {
      "name": "refuse a version that is no version",
      "http": {
        "method": "PUT",
        "path": "/api/v1/dispatcher/config",
        "body": { "version": 0 }
      }
    },
    { "name": "add an account", "cli": { "args": ["account", "add", "Max"] } },
    {
      "name": "write a profile with an account",
      "file": {
        "path": "{{WORK}}/accounts.json",
        "lines": [
          {
            "profiles": [
              {
                "name": "small",
                "model": "sonnet",
                "effort": "high",
                "maxTurns": 40,
                "timeoutMinutes": 45,
                "accounts": []
              },
              {
                "name": "medium",
                "model": "opus",
                "effort": "high",
                "maxTurns": 80,
                "timeoutMinutes": 90,
                "accounts": ["max", "default"]
              }
            ],
            "rules": [
              { "when": { "priorities": ["urgent"] }, "profile": "medium", "accounts": ["max"] }
            ]
          }
        ]
      }
    },
    {
      "name": "allow the account",
      "cli": { "args": ["dispatcher", "config", "set", "--file", "{{WORK}}/accounts.json"] }
    },
    {
      "name": "show the accounts of the profiles",
      "cli": { "args": ["dispatcher", "config", "show"] }
    },
    {
      "name": "read the final configuration",
      "http": { "method": "GET", "path": "/api/v1/dispatcher/config" }
    }
  ]
}
