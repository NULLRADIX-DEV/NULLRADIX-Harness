{
  "title": "A ticket held for review goes back to the agent with feedback, which the next instruction carries",
  "env": {
    "FAKE_CLAUDE_MODE": "review"
  },
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": {
          "key": "ARC",
          "name": "Arches"
        }
      },
      "save": {
        "project": "json.id"
      }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": {
          "name": "Main"
        }
      },
      "save": {
        "board": "json.id"
      }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "init": "json.id"
      }
    },
    {
      "name": "initialized",
      "wait": {
        "path": "/api/v1/runs/{{init}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the readme",
      "file": {
        "path": "{{WORK}}/arches/README.md",
        "text": "# Arches\n"
      }
    },
    {
      "name": "the price module",
      "file": {
        "path": "{{WORK}}/arches/src/price.ts",
        "text": "export const price = (net: number) => net;\n"
      }
    },
    {
      "name": "a module that goes away",
      "file": {
        "path": "{{WORK}}/arches/src/old.ts",
        "text": "export const OLD = true;\n"
      }
    },
    {
      "name": "a note that moves",
      "file": {
        "path": "{{WORK}}/arches/docs/note.md",
        "text": "The prices\nare in\nsrc/price.ts\nand nowhere else\nat all.\n"
      }
    },
    {
      "name": "stage the files",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git add",
          "program": "git",
          "args": ["add", "-A"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "add": "json.id"
      }
    },
    {
      "name": "staged",
      "wait": {
        "path": "/api/v1/runs/{{add}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "first commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git commit",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "-c",
            "commit.gpgsign=false",
            "commit",
            "-q",
            "-m",
            "init"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "commit": "json.id"
      }
    },
    {
      "name": "committed",
      "wait": {
        "path": "/api/v1/runs/{{commit}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "long paths on already, so every platform prints the same",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git config",
          "program": "git",
          "args": ["config", "core.longpaths", "true"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "config": "json.id"
      }
    },
    {
      "name": "configured",
      "wait": {
        "path": "/api/v1/runs/{{config}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "bind the board",
      "cli": {
        "args": ["board", "repo", "{{board}}", "{{WORK}}/arches"]
      }
    },
    {
      "name": "a ready ticket",
      "cli": {
        "args": [
          "ticket",
          "create",
          "Build the discount",
          "--board",
          "{{board}}",
          "--label",
          "auto",
          "--acceptance",
          "The price drops by the discount",
          "--planned"
        ]
      }
    },
    {
      "name": "a ticket the dispatcher never takes",
      "cli": {
        "args": ["ticket", "create", "Check the shipping", "--board", "{{board}}"]
      }
    },
    {
      "name": "plan the first",
      "cli": {
        "args": ["plan", "write", "ARC-1", "--plan", "Apply it", "--handbook", "npx vitest run"]
      }
    },
    {
      "name": "switch on",
      "cli": {
        "args": ["dispatcher", "enable"]
      }
    },
    {
      "name": "a pass starts the ticket",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "the run ended",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work",
        "field": "items.0.status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the agent finishes its ticket",
      "cli": {
        "args": [
          "ticket",
          "move",
          "ARC-1",
          "done",
          "--acceptance",
          "The price drops by the discount",
          "--author",
          "worker-ARC-0001"
        ]
      }
    },
    {
      "name": "the next pass holds the finished ticket for review",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "the ticket waits for a person",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1"
      }
    },
    {
      "name": "a return without feedback text",
      "cli": {
        "args": ["ticket", "return", "ARC-1", "--feedback", "   "]
      }
    },
    {
      "name": "a return without a feedback field",
      "http": {
        "method": "POST",
        "path": "/api/v1/tickets/ARC-1/review/return",
        "body": {}
      }
    },
    {
      "name": "a return with blank feedback",
      "http": {
        "method": "POST",
        "path": "/api/v1/tickets/ARC-1/review/return",
        "body": {
          "feedback": "   "
        }
      }
    },
    {
      "name": "a return with feedback that is no text",
      "http": {
        "method": "POST",
        "path": "/api/v1/tickets/ARC-1/review/return",
        "body": {
          "feedback": 7
        }
      }
    },
    {
      "name": "a return with feedback over the limit",
      "http": {
        "method": "POST",
        "path": "/api/v1/tickets/ARC-1/review/return",
        "body": {
          "feedback": ""
        }
      }
    },
    {
      "name": "a return of a ticket that waits for no review",
      "http": {
        "method": "POST",
        "path": "/api/v1/tickets/ARC-2/review/return",
        "body": {
          "feedback": "Please add a test."
        }
      }
    },
    {
      "name": "a return of an unknown ticket",
      "http": {
        "method": "POST",
        "path": "/api/v1/tickets/ARC-99/review/return",
        "body": {
          "feedback": "Please add a test."
        }
      }
    },
    {
      "name": "a return on a stale version",
      "http": {
        "method": "POST",
        "path": "/api/v1/tickets/ARC-1/review/return",
        "body": {
          "feedback": "Please add a test.",
          "version": 1
        }
      }
    },
    {
      "name": "back to the agent with feedback",
      "cli": {
        "args": ["ticket", "return", "ARC-1", "--feedback", "Please add a test for the discount."]
      }
    },
    {
      "name": "the ticket is planned again and keeps its branch and worktree",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1"
      }
    },
    {
      "name": "the feedback is a comment of the dispatcher",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1/comments"
      }
    },
    {
      "name": "the review stays readable and is returned",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1/review"
      }
    },
    {
      "name": "the next instruction carries the feedback",
      "http": {
        "method": "POST",
        "path": "/api/v1/dispatcher/prompt-previews",
        "body": {
          "kind": "work",
          "key": "ARC-1"
        }
      }
    },
    {
      "name": "the same return again changes nothing",
      "http": {
        "method": "POST",
        "path": "/api/v1/tickets/ARC-1/review/return",
        "body": {
          "feedback": "And another hint."
        }
      }
    },
    {
      "name": "the ticket after the repeat",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1"
      }
    },
    {
      "name": "an accept of a ticket that is planned again",
      "http": {
        "method": "POST",
        "path": "/api/v1/tickets/ARC-1/review/accept",
        "body": {}
      }
    }
  ]
}
