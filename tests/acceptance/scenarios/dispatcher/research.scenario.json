{
  "title": "Research on open questions by hand and by the automation: start, refusals, a saved research, a run that left none",
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": { "key": "ARC", "name": "Arches" }
      },
      "save": { "project": "json.id" }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": { "name": "Main" }
      },
      "save": { "board": "json.id" }
    },
    {
      "name": "a project without a board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": { "key": "OTH", "name": "Others" }
      }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": { "init": "json.id" }
    },
    {
      "name": "initialized",
      "wait": { "path": "/api/v1/runs/{{init}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "first commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git commit",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "commit",
            "-q",
            "--allow-empty",
            "-m",
            "init"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "commit": "json.id" }
    },
    {
      "name": "committed",
      "wait": { "path": "/api/v1/runs/{{commit}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "long paths on already, so every platform prints the same",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git config",
          "program": "git",
          "args": ["config", "core.longpaths", "true"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "config": "json.id" }
    },
    {
      "name": "configured",
      "wait": { "path": "/api/v1/runs/{{config}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "bind the board",
      "cli": { "args": ["board", "repo", "{{board}}", "{{WORK}}/arches"] }
    },
    {
      "name": "an open question",
      "cli": {
        "args": [
          "question",
          "add",
          "Does the discount apply to shipping too?",
          "--project",
          "ARC",
          "--description",
          "The price list names both apart."
        ]
      }
    },
    {
      "name": "a question that gets decided",
      "cli": { "args": ["question", "add", "Which currency abroad?", "--project", "ARC"] }
    },
    {
      "name": "decide it",
      "http": {
        "method": "POST",
        "path": "/api/v1/questions/ARC-Q2/answer",
        "body": { "text": "Always euro.", "reason": "All prices are in euro." }
      }
    },
    {
      "name": "a third question for the failure paths",
      "cli": { "args": ["question", "add", "Who maintains the price list?", "--project", "ARC"] }
    },
    {
      "name": "a question of the project without a board",
      "cli": { "args": ["question", "add", "Where does it run?", "--project", "OTH"] }
    },
    {
      "name": "research an unknown question",
      "http": { "method": "POST", "path": "/api/v1/questions/ARC-Q99/research-runs", "body": {} }
    },
    {
      "name": "research something that is no question key",
      "http": { "method": "POST", "path": "/api/v1/questions/ARC-1/research-runs", "body": {} }
    },
    {
      "name": "research a decided question",
      "http": { "method": "POST", "path": "/api/v1/questions/ARC-Q2/research-runs", "body": {} }
    },
    {
      "name": "research a question of a project without a repository",
      "http": { "method": "POST", "path": "/api/v1/questions/OTH-Q1/research-runs", "body": {} }
    },
    {
      "name": "the state before the research",
      "http": { "method": "GET", "path": "/api/v1/runs?questionKey=ARC-Q1&kind=research" }
    },
    {
      "name": "start the research by hand, the dispatcher being off",
      "cli": { "args": ["research", "start", "arc-q1"] }
    },
    {
      "name": "the run is there",
      "http": { "method": "GET", "path": "/api/v1/runs?questionKey=ARC-Q1&kind=research" }
    },
    {
      "name": "the run ended",
      "wait": {
        "path": "/api/v1/runs?questionKey=ARC-Q1&kind=research",
        "field": "items.0.status",
        "equals": "succeeded"
      }
    },
    {
      "name": "start it a second time while the first is not settled",
      "http": { "method": "POST", "path": "/api/v1/questions/ARC-Q1/research-runs", "body": {} }
    },
    {
      "name": "a pause holds a research back",
      "cli": { "args": ["dispatcher", "pause", "--minutes", "30"] }
    },
    {
      "name": "research during the pause",
      "http": { "method": "POST", "path": "/api/v1/questions/ARC-Q3/research-runs", "body": {} }
    },
    { "name": "lift the pause", "cli": { "args": ["dispatcher", "resume"] } },
    {
      "name": "the research file the agent writes",
      "file": {
        "path": "{{WORK}}/research.json",
        "text": "{\"context\":\"**Today** the discount applies to goods only.\",\"options\":[{\"title\":\"Goods only\",\"text\":\"Keep it. Effort: small\",\"pros\":[\"No change\"],\"cons\":[\"Customers ask\"],\"recommended\":true},{\"title\":\"Goods and shipping\",\"text\":\"Extend it. Effort: medium\",\"pros\":[\"Simple to explain\"]}]}"
      }
    },
    {
      "name": "the agent saves it",
      "cli": {
        "args": [
          "research",
          "submit",
          "ARC-Q1",
          "--file",
          "{{WORK}}/research.json",
          "--author",
          "research-ARC-Q0001"
        ]
      }
    },
    { "name": "a pass settles the run", "cli": { "args": ["dispatcher", "run"] } },
    {
      "name": "the run with its outcome",
      "http": { "method": "GET", "path": "/api/v1/runs?questionKey=ARC-Q1&kind=research" }
    },
    {
      "name": "the question with the research",
      "http": { "method": "GET", "path": "/api/v1/questions/ARC-Q1" }
    },
    {
      "name": "the research in the CLI",
      "cli": { "args": ["question", "show", "ARC-Q1"] }
    },
    {
      "name": "the research folder is gone, only the main folder is left",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git worktree list",
          "program": "git",
          "args": ["worktree", "list", "--porcelain"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "listing": "json.id" }
    },
    {
      "name": "listed",
      "wait": { "path": "/api/v1/runs/{{listing}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "the list",
      "http": { "method": "GET", "path": "/api/v1/runs/{{listing}}/output" }
    },
    {
      "name": "research the third question, which stays without a result",
      "http": { "method": "POST", "path": "/api/v1/questions/ARC-Q3/research-runs", "body": {} }
    },
    {
      "name": "the second run ended",
      "wait": {
        "path": "/api/v1/runs?questionKey=ARC-Q3&kind=research",
        "field": "items.0.status",
        "equals": "succeeded"
      }
    },
    { "name": "a pass settles it", "cli": { "args": ["dispatcher", "run"] } },
    {
      "name": "the run is settled",
      "http": { "method": "GET", "path": "/api/v1/runs?questionKey=ARC-Q3&kind=research" }
    },
    {
      "name": "the question says so and stays open",
      "http": { "method": "GET", "path": "/api/v1/questions/ARC-Q3/comments" }
    },
    {
      "name": "a research without anything is refused",
      "http": { "method": "POST", "path": "/api/v1/questions/ARC-Q3/research", "body": {} }
    },
    {
      "name": "a research of an unknown question is refused",
      "http": {
        "method": "POST",
        "path": "/api/v1/questions/ARC-Q99/research",
        "body": { "context": "x" }
      }
    },
    {
      "name": "the automation takes up only questions that come after it is switched on",
      "file": {
        "path": "{{WORK}}/auto.json",
        "lines": [{ "research": { "auto": true, "wip": 2, "maxPerDay": 5 } }]
      }
    },
    {
      "name": "switch it on",
      "cli": { "args": ["dispatcher", "config", "set", "--file", "{{WORK}}/auto.json"] }
    },
    {
      "name": "a pass starts nothing, the open questions are older",
      "cli": { "args": ["dispatcher", "run"] }
    },
    {
      "name": "a new question",
      "cli": { "args": ["question", "add", "Is the price list public?", "--project", "ARC"] }
    },
    { "name": "a pass starts its research", "cli": { "args": ["dispatcher", "run"] } },
    {
      "name": "the run of the new question",
      "http": { "method": "GET", "path": "/api/v1/runs?questionKey=ARC-Q4&kind=research" }
    },
    {
      "name": "the older question was left alone",
      "http": { "method": "GET", "path": "/api/v1/runs?questionKey=ARC-Q3&kind=research" }
    }
  ]
}
