{
  "title": "A finished ticket waits for review; its changes, patches and files at the branch head can be read",
  "env": { "FAKE_CLAUDE_MODE": "review" },
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": { "key": "ARC", "name": "Arches" }
      },
      "save": { "project": "json.id" }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": { "name": "Main" }
      },
      "save": { "board": "json.id" }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": { "init": "json.id" }
    },
    {
      "name": "initialized",
      "wait": { "path": "/api/v1/runs/{{init}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "the readme",
      "file": { "path": "{{WORK}}/arches/README.md", "text": "# Arches\n" }
    },
    {
      "name": "the price module",
      "file": {
        "path": "{{WORK}}/arches/src/price.ts",
        "text": "export const price = (net: number) => net;\n"
      }
    },
    {
      "name": "a module that goes away",
      "file": { "path": "{{WORK}}/arches/src/old.ts", "text": "export const OLD = true;\n" }
    },
    {
      "name": "a note that moves",
      "file": {
        "path": "{{WORK}}/arches/docs/note.md",
        "text": "The prices\nare in\nsrc/price.ts\nand nowhere else\nat all.\n"
      }
    },
    {
      "name": "stage the files",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git add",
          "program": "git",
          "args": ["add", "-A"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "add": "json.id" }
    },
    {
      "name": "staged",
      "wait": { "path": "/api/v1/runs/{{add}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "first commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git commit",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "-c",
            "commit.gpgsign=false",
            "commit",
            "-q",
            "-m",
            "init"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "commit": "json.id" }
    },
    {
      "name": "committed",
      "wait": { "path": "/api/v1/runs/{{commit}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "long paths on already, so every platform prints the same",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git config",
          "program": "git",
          "args": ["config", "core.longpaths", "true"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "config": "json.id" }
    },
    {
      "name": "configured",
      "wait": { "path": "/api/v1/runs/{{config}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "bind the board",
      "cli": { "args": ["board", "repo", "{{board}}", "{{WORK}}/arches"] }
    },
    {
      "name": "a ready ticket",
      "cli": {
        "args": [
          "ticket",
          "create",
          "Build the discount",
          "--board",
          "{{board}}",
          "--label",
          "auto",
          "--acceptance",
          "The price drops by the discount",
          "--planned"
        ]
      }
    },
    {
      "name": "a ticket the dispatcher never takes",
      "cli": {
        "args": ["ticket", "create", "Check the shipping", "--board", "{{board}}"]
      }
    },
    {
      "name": "plan the first",
      "cli": {
        "args": ["plan", "write", "ARC-1", "--plan", "Apply it", "--handbook", "npx vitest run"]
      }
    },
    { "name": "switch on", "cli": { "args": ["dispatcher", "enable"] } },
    { "name": "a pass starts the ticket", "cli": { "args": ["dispatcher", "run"] } },
    {
      "name": "the run ended",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work",
        "field": "items.0.status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the agent finishes its ticket",
      "cli": {
        "args": [
          "ticket",
          "move",
          "ARC-1",
          "done",
          "--acceptance",
          "The price drops by the discount",
          "--author",
          "worker-ARC-0001"
        ]
      }
    },
    {
      "name": "the next pass holds the finished ticket for review",
      "cli": { "args": ["dispatcher", "run"] }
    },
    {
      "name": "the run is settled as review",
      "http": { "method": "GET", "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work" }
    },
    {
      "name": "the ticket waits for a person",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1" }
    },
    {
      "name": "the review lists the changes and the tests",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review" }
    },
    {
      "name": "the review with a lower case key",
      "http": { "method": "GET", "path": "/api/v1/tickets/arc-1/review" }
    },
    {
      "name": "the patch of a changed file",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/diff?path=src/price.ts" }
    },
    {
      "name": "the patch of a new file",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/diff?path=src/discount.ts" }
    },
    {
      "name": "the patch of a deleted file",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/diff?path=src/old.ts" }
    },
    {
      "name": "the patch of a renamed file",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/diff?path=docs/hint.md" }
    },
    {
      "name": "the patch of a binary file",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/diff?path=logo.bin" }
    },
    {
      "name": "a patch of a file the branch did not change",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/diff?path=README.md" }
    },
    {
      "name": "a patch without a path",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/diff" }
    },
    {
      "name": "a patch with an empty path",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/diff?path=" }
    },
    {
      "name": "a patch of a path that leaves the repository",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/diff?path=../outside" }
    },
    {
      "name": "a text file at the head of the branch",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/files/src/price.ts" }
    },
    {
      "name": "a file the branch did not change",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/files/README.md" }
    },
    {
      "name": "a binary file",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/files/logo.bin" }
    },
    {
      "name": "a deleted file is not at the head",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/files/src/old.ts" }
    },
    {
      "name": "a folder is no file",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/files/src" }
    },
    {
      "name": "a path that leaves the repository",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/review/files/..%2F..%2Foutside" }
    },
    {
      "name": "the review of a ticket without a branch",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-2/review" }
    },
    {
      "name": "a patch of a ticket without a branch",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-2/review/diff?path=src/price.ts" }
    },
    {
      "name": "a file of a ticket without a branch",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-2/review/files/src/price.ts" }
    },
    {
      "name": "the review of an unknown ticket",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-99/review" }
    },
    {
      "name": "a file of an unknown ticket",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-99/review/files/src/price.ts" }
    }
  ]
}
