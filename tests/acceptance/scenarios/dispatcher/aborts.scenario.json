{
  "title": "Three aborted attempts end as a final abort and each start climbs one step of the ladder",
  "env": { "FAKE_CLAUDE_MODE": "max-turns" },
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": { "key": "ARC", "name": "Arches" }
      },
      "save": { "project": "json.id" }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": { "name": "Main" }
      },
      "save": { "board": "json.id" }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": { "init": "json.id" }
    },
    {
      "name": "initialized",
      "wait": { "path": "/api/v1/runs/{{init}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "first commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git commit",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "commit",
            "-q",
            "--allow-empty",
            "-m",
            "init"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "commit": "json.id" }
    },
    {
      "name": "committed",
      "wait": { "path": "/api/v1/runs/{{commit}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "long paths on already, so every platform prints the same",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git config",
          "program": "git",
          "args": ["config", "core.longpaths", "true"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "config": "json.id" }
    },
    {
      "name": "configured",
      "wait": { "path": "/api/v1/runs/{{config}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "bind the board",
      "cli": { "args": ["board", "repo", "{{board}}", "{{WORK}}/arches"] }
    },
    {
      "name": "a ready ticket",
      "cli": {
        "args": [
          "ticket",
          "create",
          "Build the login",
          "--board",
          "{{board}}",
          "--label",
          "auto",
          "--acceptance",
          "Login works",
          "--planned"
        ]
      }
    },
    {
      "name": "plan the ticket",
      "cli": {
        "args": ["plan", "write", "ARC-1", "--plan", "Build it", "--handbook", "cargo test"]
      }
    },
    {
      "name": "write three attempts",
      "file": { "path": "{{WORK}}/attempts.json", "lines": [{ "maxAttempts": 3 }] }
    },
    {
      "name": "allow three attempts",
      "cli": { "args": ["dispatcher", "config", "set", "--file", "{{WORK}}/attempts.json"] }
    },
    { "name": "switch on", "cli": { "args": ["dispatcher", "enable"] } },
    { "name": "a pass starts the first attempt", "cli": { "args": ["dispatcher", "run"] } },
    {
      "name": "the first run ran out of turns",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work",
        "field": "items.0.status",
        "equals": "failed"
      }
    },
    {
      "name": "the next pass counts the first abort and starts the second attempt one step higher",
      "cli": { "args": ["dispatcher", "run"] }
    },
    {
      "name": "the second run ran out of turns",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work",
        "field": "items.0.status",
        "equals": "failed"
      }
    },
    {
      "name": "the next pass counts the second abort and starts the third attempt",
      "cli": { "args": ["dispatcher", "run"] }
    },
    {
      "name": "the third run ran out of turns",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work",
        "field": "items.0.status",
        "equals": "failed"
      }
    },
    {
      "name": "the next pass counts the last abort and blocks the ticket",
      "cli": { "args": ["dispatcher", "run"] }
    },
    {
      "name": "the runs with their profiles and outcomes",
      "http": { "method": "GET", "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work" }
    },
    {
      "name": "the ticket is blocked for a person",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1" }
    },
    {
      "name": "the comments of the dispatcher",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/comments" }
    },
    { "name": "one more pass starts nothing", "cli": { "args": ["dispatcher", "run"] } }
  ]
}
