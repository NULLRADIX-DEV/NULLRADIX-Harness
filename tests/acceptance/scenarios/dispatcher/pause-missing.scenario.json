{
  "title": "Missing Claude pauses the dispatcher and counts no attempt",
  "env": { "NULLRADIX_CLAUDE": "nullradix-no-such-claude" },
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": { "key": "ARC", "name": "Arches" }
      },
      "save": { "project": "json.id" }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": { "name": "Main" }
      },
      "save": { "board": "json.id" }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": { "init": "json.id" }
    },
    {
      "name": "initialized",
      "wait": { "path": "/api/v1/runs/{{init}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "first commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git commit",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "commit",
            "-q",
            "--allow-empty",
            "-m",
            "init"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "commit": "json.id" }
    },
    {
      "name": "committed",
      "wait": { "path": "/api/v1/runs/{{commit}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "long paths on already, so every platform prints the same",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git config",
          "program": "git",
          "args": ["config", "core.longpaths", "true"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "config": "json.id" }
    },
    {
      "name": "configured",
      "wait": { "path": "/api/v1/runs/{{config}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "bind the board",
      "cli": { "args": ["board", "repo", "{{board}}", "{{WORK}}/arches"] }
    },
    {
      "name": "a ready ticket",
      "cli": {
        "args": [
          "ticket",
          "create",
          "Build the login",
          "--board",
          "{{board}}",
          "--label",
          "auto",
          "--acceptance",
          "Login works",
          "--planned"
        ]
      }
    },
    {
      "name": "plan the ticket",
      "cli": {
        "args": ["plan", "write", "ARC-1", "--plan", "Build it", "--handbook", "cargo test"]
      }
    },
    { "name": "switch on", "cli": { "args": ["dispatcher", "enable"] } },
    { "name": "a pass starts the run", "cli": { "args": ["dispatcher", "run"] } },
    {
      "name": "the run could not start Claude",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work",
        "field": "items.0.status",
        "equals": "failed"
      }
    },
    {
      "name": "the next pass pauses instead of counting an attempt",
      "cli": { "args": ["dispatcher", "run"] }
    },
    {
      "name": "the dispatcher is paused",
      "http": { "method": "GET", "path": "/api/v1/dispatcher" }
    },
    {
      "name": "the run is settled as a missing-Claude pause",
      "http": { "method": "GET", "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work" }
    },
    {
      "name": "the ticket is back to planned",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1" }
    },
    {
      "name": "the pause comment counts no attempt",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-1/comments" }
    },
    { "name": "a paused dispatcher starts nothing", "cli": { "args": ["dispatcher", "run"] } }
  ]
}
