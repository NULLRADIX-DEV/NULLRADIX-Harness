{
  "title": "A dirty file the branch also changes holds the merge, which goes through once the file is clean",
  "env": {
    "FAKE_CLAUDE_MODE": "review",
    "GIT_AUTHOR_NAME": "t",
    "GIT_AUTHOR_EMAIL": "t@example.com",
    "GIT_COMMITTER_NAME": "t",
    "GIT_COMMITTER_EMAIL": "t@example.com"
  },
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": {
          "key": "ARC",
          "name": "Arches"
        }
      },
      "save": {
        "project": "json.id"
      }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": {
          "name": "Main"
        }
      },
      "save": {
        "board": "json.id"
      }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "init": "json.id"
      }
    },
    {
      "name": "initialized",
      "wait": {
        "path": "/api/v1/runs/{{init}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the readme",
      "file": {
        "path": "{{WORK}}/arches/README.md",
        "text": "# Arches\n"
      }
    },
    {
      "name": "the price module",
      "file": {
        "path": "{{WORK}}/arches/src/price.ts",
        "text": "export const price = (net: number) => net;\n"
      }
    },
    {
      "name": "a module that goes away",
      "file": {
        "path": "{{WORK}}/arches/src/old.ts",
        "text": "export const OLD = true;\n"
      }
    },
    {
      "name": "a note that moves",
      "file": {
        "path": "{{WORK}}/arches/docs/note.md",
        "text": "The prices\nare in\nsrc/price.ts\nand nowhere else\nat all.\n"
      }
    },
    {
      "name": "stage the files",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git add",
          "program": "git",
          "args": ["add", "-A"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "add": "json.id"
      }
    },
    {
      "name": "staged",
      "wait": {
        "path": "/api/v1/runs/{{add}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "first commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git commit",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "-c",
            "commit.gpgsign=false",
            "commit",
            "-q",
            "-m",
            "init"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "commit": "json.id"
      }
    },
    {
      "name": "committed",
      "wait": {
        "path": "/api/v1/runs/{{commit}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "long paths on already, so every platform prints the same",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git config",
          "program": "git",
          "args": ["config", "core.longpaths", "true"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "config": "json.id"
      }
    },
    {
      "name": "configured",
      "wait": {
        "path": "/api/v1/runs/{{config}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "bind the board",
      "cli": {
        "args": ["board", "repo", "{{board}}", "{{WORK}}/arches"]
      }
    },
    {
      "name": "a ready ticket",
      "cli": {
        "args": [
          "ticket",
          "create",
          "Build the discount",
          "--board",
          "{{board}}",
          "--label",
          "auto",
          "--acceptance",
          "The price drops by the discount",
          "--planned"
        ]
      }
    },
    {
      "name": "a ticket the dispatcher never takes",
      "cli": {
        "args": ["ticket", "create", "Check the shipping", "--board", "{{board}}"]
      }
    },
    {
      "name": "plan the first",
      "cli": {
        "args": ["plan", "write", "ARC-1", "--plan", "Apply it", "--handbook", "npx vitest run"]
      }
    },
    {
      "name": "switch on",
      "cli": {
        "args": ["dispatcher", "enable"]
      }
    },
    {
      "name": "a pass starts the ticket",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "the run ended",
      "wait": {
        "path": "/api/v1/runs?ticketKey=ARC-0001&kind=work",
        "field": "items.0.status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the agent finishes its ticket",
      "cli": {
        "args": [
          "ticket",
          "move",
          "ARC-1",
          "done",
          "--acceptance",
          "The price drops by the discount",
          "--author",
          "worker-ARC-0001"
        ]
      }
    },
    {
      "name": "the next pass holds the finished ticket for review",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "the ticket waits for a person",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1"
      }
    },
    {
      "name": "a pass merges nothing yet",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "a person edits the same module in the main checkout",
      "file": {
        "path": "{{WORK}}/arches/src/price.ts",
        "text": "export const price = (net: number) => net + 1;\n"
      }
    },
    {
      "name": "accept the held ticket",
      "cli": {
        "args": ["ticket", "accept", "ARC-1"]
      }
    },
    {
      "name": "the next pass holds the merge",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "the ticket is still done with its branch",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1"
      }
    },
    {
      "name": "the merge waits and names the file",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1/merges"
      }
    },
    {
      "name": "the comments say it once",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1/comments"
      }
    },
    {
      "name": "the inbox has no merge entry",
      "cli": {
        "args": ["inbox", "--kind", "merge"]
      }
    },
    {
      "name": "another pass changes nothing",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "still one comment",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1/comments"
      }
    },
    {
      "name": "the person discards the edit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git",
          "program": "git",
          "args": ["checkout", "--", "src/price.ts"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": {
        "g1": "json.id"
      }
    },
    {
      "name": "the person discards the edit finished",
      "wait": {
        "path": "/api/v1/runs/{{g1}}",
        "field": "status",
        "equals": "succeeded"
      }
    },
    {
      "name": "the next pass merges the branch",
      "cli": {
        "args": ["dispatcher", "run"]
      }
    },
    {
      "name": "the ticket is done and its branch is cleared",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1"
      }
    },
    {
      "name": "the merge is listed as merged",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1/merges"
      }
    }
  ]
}
