{
  "title": "Work steps are numbered from 1 and guarded as on the legacy board",
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": {
          "key": "ARC",
          "name": "Arches"
        }
      },
      "save": {
        "project": "json.id"
      }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": {
          "name": "Main"
        }
      },
      "save": {
        "board": "json.id"
      }
    },
    {
      "name": "create with steps",
      "cli": {
        "args": [
          "ticket",
          "create",
          "Stepped",
          "--board",
          "{{board}}",
          "--step",
          "Write",
          "--step",
          "Test"
        ]
      }
    },
    {
      "name": "check the first",
      "cli": {
        "args": ["step", "check", "ARC-1", "1"]
      }
    },
    {
      "name": "add at the front",
      "cli": {
        "args": ["step", "add", "ARC-1", "Plan", "--at", "1", "--detail", "Think first"]
      }
    },
    {
      "name": "read the steps",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1"
      },
      "save": {
        "plan": "json.steps.0.id"
      }
    },
    {
      "name": "a step that moved",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/tickets/ARC-1/steps/{{plan}}",
        "body": {
          "done": true,
          "expectText": "Write"
        }
      }
    },
    {
      "name": "no such step",
      "http": {
        "method": "PATCH",
        "path": "/api/v1/tickets/ARC-1/steps/0190a0b0-0000-7000-8000-00000000dead",
        "body": {
          "done": true
        }
      }
    },
    {
      "name": "stale add",
      "http": {
        "method": "POST",
        "path": "/api/v1/tickets/ARC-1/steps",
        "body": {
          "text": "Late",
          "version": 1
        }
      }
    },
    {
      "name": "edit the guidance away",
      "cli": {
        "args": ["step", "edit", "ARC-1", "1", "--text", "Plan it", "--detail", ""]
      }
    },
    {
      "name": "move to the end",
      "cli": {
        "args": ["step", "move", "ARC-1", "1", "3"]
      }
    },
    {
      "name": "remove one",
      "cli": {
        "args": ["step", "remove", "ARC-1", "2", "--expect", "Test"]
      }
    },
    {
      "name": "read what is left",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1"
      },
      "save": {
        "last": "json.steps.1.id"
      }
    },
    {
      "name": "remove with a wrong text",
      "http": {
        "method": "DELETE",
        "path": "/api/v1/tickets/ARC-1/steps/{{last}}?expectText=Other"
      }
    },
    {
      "name": "remove with version and text",
      "http": {
        "method": "DELETE",
        "path": "/api/v1/tickets/ARC-1/steps/{{last}}?version=6&expectText=Plan%20it"
      }
    },
    {
      "name": "list shows progress",
      "cli": {
        "args": ["ticket", "list", "--board", "all"]
      }
    },
    {
      "name": "an agent adds a step",
      "cli": {
        "args": ["step", "add", "ARC-1", "Agent step", "--author", "claude"],
        "env": {
          "NULLRADIX_SESSION": "session-1"
        }
      }
    },
    {
      "name": "an agent checks it",
      "cli": {
        "args": ["step", "check", "ARC-1", "2", "--author", "claude"],
        "env": {
          "NULLRADIX_SESSION": "session-1"
        }
      }
    },
    {
      "name": "detail",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1"
      }
    }
  ]
}
