{
  "title": "Accepting a ticket that waits for a person stays with the person, not with a run or a session of an agent",
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": {
          "key": "ARC",
          "name": "Arches"
        }
      },
      "save": {
        "project": "json.id"
      }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": {
          "name": "Main"
        }
      },
      "save": {
        "board": "json.id"
      }
    },
    {
      "name": "the board to work on",
      "cli": {
        "args": ["board", "use", "{{board}}"]
      }
    },
    {
      "name": "first ticket",
      "cli": {
        "args": ["ticket", "create", "Login page", "--acceptance", "Users can log in"]
      }
    },
    {
      "name": "second ticket",
      "cli": {
        "args": ["ticket", "create", "Logout page", "--acceptance", "Users can log out"]
      }
    },
    {
      "name": "the first waits for a person",
      "cli": {
        "args": [
          "ticket",
          "set",
          "ARC-1",
          "--status",
          "blocked",
          "--blocked-reason",
          "Human Interaction: look at it",
          "--author",
          "claude"
        ]
      }
    },
    {
      "name": "the second waits for a person",
      "cli": {
        "args": [
          "ticket",
          "set",
          "ARC-2",
          "--status",
          "blocked",
          "--blocked-reason",
          "Human Interaction: look at it",
          "--author",
          "claude"
        ]
      }
    },
    {
      "name": "a run cannot accept it",
      "cli": {
        "args": ["ticket", "accept", "ARC-1"],
        "env": {
          "NULLRADIX_RUN": "run-1"
        }
      }
    },
    {
      "name": "a session cannot accept it",
      "cli": {
        "args": ["ticket", "accept", "ARC-1"],
        "env": {
          "NULLRADIX_SESSION": "session-1"
        }
      }
    },
    {
      "name": "a run cannot set it to done instead",
      "cli": {
        "args": ["ticket", "set", "ARC-1", "--status", "done", "--author", "claude"],
        "env": {
          "NULLRADIX_RUN": "run-1"
        }
      }
    },
    {
      "name": "a session cannot move it to done",
      "cli": {
        "args": ["ticket", "move", "ARC-1", "done"],
        "env": {
          "NULLRADIX_SESSION": "session-1"
        }
      }
    },
    {
      "name": "a run cannot replace the reason",
      "cli": {
        "args": ["ticket", "set", "ARC-1", "--blocked-reason", "waiting for a key"],
        "env": {
          "NULLRADIX_RUN": "run-1"
        }
      }
    },
    {
      "name": "a run cannot clear the reason",
      "cli": {
        "args": ["ticket", "set", "ARC-1", "--blocked-reason", ""],
        "env": {
          "NULLRADIX_RUN": "run-1"
        }
      }
    },
    {
      "name": "a run cannot return it to the agent",
      "cli": {
        "args": ["ticket", "return", "ARC-1", "--feedback", "more tests"],
        "env": {
          "NULLRADIX_RUN": "run-1"
        }
      }
    },
    {
      "name": "a run cannot delete it",
      "cli": {
        "args": ["ticket", "delete", "ARC-1"],
        "env": {
          "NULLRADIX_RUN": "run-1"
        }
      }
    },
    {
      "name": "a session cannot delete it",
      "cli": {
        "args": ["ticket", "delete", "ARC-1"],
        "env": {
          "NULLRADIX_SESSION": "session-1"
        }
      }
    },
    {
      "name": "a session cannot plan it into planned",
      "cli": {
        "args": ["plan", "write", "ARC-1", "--plan", "Do it"],
        "env": {
          "NULLRADIX_SESSION": "session-1"
        }
      }
    },
    {
      "name": "a run claims planning but the ticket still waits",
      "cli": {
        "args": ["plan", "claim", "ARC-1", "--agent", "planner"],
        "env": {
          "NULLRADIX_RUN": "run-1"
        }
      }
    },
    {
      "name": "the ticket still waits",
      "http": {
        "method": "GET",
        "path": "/api/v1/tickets/ARC-1",
        "keep": ["ticket.key", "ticket.status", "ticket.blockedReason"]
      }
    },
    {
      "name": "the person accepts at a terminal",
      "cli": {
        "args": ["ticket", "accept", "ARC-1"]
      }
    },
    {
      "name": "the person accepts the second in the app",
      "http": {
        "method": "POST",
        "path": "/api/v1/tickets/ARC-2/accept",
        "body": {},
        "auth": "session",
        "keep": ["key", "status"]
      }
    }
  ]
}
