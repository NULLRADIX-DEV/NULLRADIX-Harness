{
  "title": "Tickets start in their own worktree of the board's repository or join one",
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": { "key": "ARC", "name": "Arches" }
      },
      "save": { "project": "json.id" }
    },
    {
      "name": "main board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": { "name": "Main" }
      },
      "save": { "main": "json.id" }
    },
    {
      "name": "empty board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": { "name": "Empty" }
      },
      "save": { "empty": "json.id" }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": { "init": "json.id" }
    },
    {
      "name": "initialized",
      "wait": { "path": "/api/v1/runs/{{init}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "first commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git commit",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "commit",
            "-q",
            "--allow-empty",
            "-m",
            "init"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "commit": "json.id" }
    },
    {
      "name": "committed",
      "wait": { "path": "/api/v1/runs/{{commit}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "long paths on already, so every platform prints the same",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git config",
          "program": "git",
          "args": ["config", "core.longpaths", "true"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "config": "json.id" }
    },
    {
      "name": "configured",
      "wait": { "path": "/api/v1/runs/{{config}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "init a repository without commits",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "other"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": { "other": "json.id" }
    },
    {
      "name": "initialized without commits",
      "wait": { "path": "/api/v1/runs/{{other}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "bind the main board",
      "cli": { "args": ["board", "repo", "{{main}}", "{{WORK}}/arches"] }
    },
    {
      "name": "bind the empty board",
      "cli": { "args": ["board", "repo", "{{empty}}", "{{WORK}}/other"] }
    },
    {
      "name": "a ticket",
      "cli": { "args": ["ticket", "create", "Fix the Löwen login!"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "a second ticket",
      "cli": { "args": ["ticket", "create", "Polish the login"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "a third ticket",
      "cli": { "args": ["ticket", "create", "Test the login"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "a ticket for the release branch",
      "cli": {
        "args": ["ticket", "create", "Release notes", "--target-branch", "release"],
        "cwd": "{{WORK}}/arches"
      }
    },
    {
      "name": "start in a new worktree",
      "cli": { "args": ["ticket", "start", "arc-1"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "join the first ticket",
      "cli": {
        "args": ["ticket", "start", "ARC-2", "--join-ticket", "arc-1"],
        "cwd": "{{WORK}}/arches"
      }
    },
    {
      "name": "join the first open worktree",
      "cli": { "args": ["ticket", "start", "ARC-3", "--join"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "another target gets its own worktree and branch",
      "cli": {
        "args": ["ticket", "start", "ARC-4", "--join-ticket", "ARC-1"],
        "cwd": "{{WORK}}/arches"
      }
    },
    {
      "name": "started already",
      "cli": { "args": ["ticket", "start", "ARC-1"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "a ticket waiting to start",
      "cli": { "args": ["ticket", "create", "Later", "--board", "{{main}}"] }
    },
    {
      "name": "the local runner",
      "wait": { "path": "/api/v1/runners", "field": "items.0.local", "equals": true },
      "save": { "runner": "json.items.0.id" }
    },
    {
      "name": "both join options",
      "http": {
        "method": "POST",
        "path": "/api/v1/tickets/ARC-0005/start",
        "body": {
          "runnerId": "{{runner}}",
          "cwd": "{{WORK}}/arches",
          "joinTicket": "ARC-0001",
          "join": true
        }
      }
    },
    {
      "name": "from a foreign repository",
      "cli": { "args": ["ticket", "start", "ARC-5"], "cwd": "{{WORK}}/other" }
    },
    {
      "name": "a ticket of the empty repository",
      "cli": { "args": ["ticket", "create", "Nothing yet", "--board", "{{empty}}"] }
    },
    {
      "name": "no commit yet",
      "cli": { "args": ["ticket", "start", "ARC-6"], "cwd": "{{WORK}}/other" }
    },
    {
      "name": "the tickets",
      "cli": { "args": ["ticket", "list"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "the joined ticket",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-0002" }
    },
    {
      "name": "list the worktrees",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git worktree list",
          "program": "git",
          "args": ["-c", "core.abbrev=40", "worktree", "list"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "list": "json.id" }
    },
    {
      "name": "listed",
      "wait": { "path": "/api/v1/runs/{{list}}", "field": "status", "equals": "succeeded" }
    },
    { "name": "the worktrees", "cli": { "args": ["run", "logs", "{{list}}"] } }
  ]
}
