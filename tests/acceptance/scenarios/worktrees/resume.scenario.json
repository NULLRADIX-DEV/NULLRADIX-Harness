{
  "title": "A started ticket whose worktree was removed gets it back on the same branch, a cleaned-up one starts afresh",
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": { "key": "ARC", "name": "Arches" }
      },
      "save": { "project": "json.id" }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": { "name": "Main" }
      },
      "save": { "main": "json.id" }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": { "init": "json.id" }
    },
    {
      "name": "initialized",
      "wait": { "path": "/api/v1/runs/{{init}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "first commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git commit",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "commit",
            "-q",
            "--allow-empty",
            "-m",
            "init"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "commit": "json.id" }
    },
    {
      "name": "committed",
      "wait": { "path": "/api/v1/runs/{{commit}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "long paths on already, so every platform prints the same",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git config",
          "program": "git",
          "args": ["config", "core.longpaths", "true"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "config": "json.id" }
    },
    {
      "name": "configured",
      "wait": { "path": "/api/v1/runs/{{config}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "bind the board",
      "cli": { "args": ["board", "repo", "{{main}}", "{{WORK}}/arches"] }
    },
    {
      "name": "a ticket",
      "cli": { "args": ["ticket", "create", "Fix the login"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "a ticket that never started cannot resume",
      "http": { "method": "POST", "path": "/api/v1/tickets/ARC-0001/resume" }
    },
    {
      "name": "start in a new worktree",
      "cli": { "args": ["ticket", "start", "ARC-1"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "a worktree that is there stays as it is",
      "http": { "method": "POST", "path": "/api/v1/tickets/ARC-0001/resume" }
    },
    {
      "name": "the worktree vanishes",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git worktree remove",
          "program": "git",
          "args": ["worktree", "remove", "--force", "{{WORK}}/arches-worktrees/ARC-0001"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "remove": "json.id" }
    },
    {
      "name": "removed",
      "wait": { "path": "/api/v1/runs/{{remove}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "the resume adds it again",
      "http": { "method": "POST", "path": "/api/v1/tickets/ARC-0001/resume" }
    },
    {
      "name": "ask the worktree for its branch",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git branch --show-current",
          "program": "git",
          "args": ["branch", "--show-current"],
          "cwd": "{{WORK}}/arches-worktrees/ARC-0001",
          "timeoutSeconds": 30
        }
      },
      "save": { "current": "json.id" }
    },
    {
      "name": "asked",
      "wait": { "path": "/api/v1/runs/{{current}}", "field": "status", "equals": "succeeded" }
    },
    { "name": "the same branch", "cli": { "args": ["run", "logs", "{{current}}"] } },
    {
      "name": "done removes the ready worktree",
      "cli": {
        "args": ["ticket", "done", "ARC-1", "--acceptance", "The login works"],
        "cwd": "{{WORK}}/arches"
      }
    },
    {
      "name": "a cleaned-up worktree is not restored, the ticket starts afresh",
      "http": { "method": "POST", "path": "/api/v1/tickets/ARC-0001/resume" }
    },
    {
      "name": "the ticket shows no branch any more",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-0001" }
    }
  ]
}
