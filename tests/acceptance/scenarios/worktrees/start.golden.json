  {
    "name": "init a repository",
    "request": {
      "body": {
        "args": [
          "init",
          "-q",
          "-b",
          "main",
          "arches"
        ],
        "cwd": "<WORK>",
        "label": "git init",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
      "path": "/api/v1/runs"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "dispatch": null,
        "error": null,
        "exitCode": null,
        "finishedAt": null,
        "id": "<ID-5>",
        "label": "git init",
        "result": null,
        "startedAt": "<TIME>",
        "status": "running",
        "version": 2
      },
      "location": "/api/v1/runs/<ID-5>",
      "status": 201
    }
  },
  {
    "field": "status",
    "name": "initialized",
    "reached": "succeeded",
    "wait": "/api/v1/runs/<ID-5>"
  },
  {
    "name": "first commit",
    "request": {
      "body": {
        "args": [
          "-c",
          "user.name=t",
          "-c",
          "user.email=t@example.com",
          "commit",
          "-q",
          "--allow-empty",
          "-m",
          "init"
        ],
        "cwd": "<WORK>/arches",
        "label": "git commit",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
      "path": "/api/v1/runs"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "dispatch": null,
        "error": null,
        "exitCode": null,
        "finishedAt": null,
        "id": "<ID-6>",
        "label": "git commit",
        "result": null,
        "startedAt": "<TIME>",
        "status": "running",
        "version": 2
      },
      "location": "/api/v1/runs/<ID-6>",
      "status": 201
    }
  },
  {
    "field": "status",
    "name": "committed",
    "reached": "succeeded",
    "wait": "/api/v1/runs/<ID-6>"
  },
  {
    "name": "long paths on already, so every platform prints the same",
    "request": {
      "body": {
        "args": [
          "config",
          "core.longpaths",
          "true"
        ],
        "cwd": "<WORK>/arches",
        "label": "git config",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
