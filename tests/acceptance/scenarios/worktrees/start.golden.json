        "startedAt": "<TIME>",
        "status": "running",
        "version": 2
      },
      "location": "/api/v1/runs/<ID-7>",
      "status": 201
    }
  },
  {
    "field": "status",
    "name": "configured",
    "reached": "succeeded",
    "wait": "/api/v1/runs/<ID-7>"
  },
  {
