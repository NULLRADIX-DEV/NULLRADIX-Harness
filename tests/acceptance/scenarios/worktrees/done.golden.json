[
  {
    "name": "project",
    "request": {
      "body": {
        "key": "ARC",
        "name": "Arches"
      },
      "method": "POST",
      "path": "/api/v1/projects"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "id": "<ID-1>",
        "key": "ARC",
        "name": "Arches",
        "updatedAt": "<TIME>",
        "version": 1
      },
      "location": "/api/v1/projects/<ID-1>",
      "status": 201
    }
  },
  {
    "name": "board",
    "request": {
      "body": {
        "name": "Main"
      },
      "method": "POST",
      "path": "/api/v1/projects/<ID-1>/boards"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "dispatchEnabled": true,
        "id": "<ID-2>",
        "name": "Main",
        "openTickets": 0,
        "ownerId": "<ID-3>",
        "ownerName": "tester",
        "projectId": "<ID-1>",
        "projectKey": "ARC",
        "repositoryId": null,
        "repositoryName": null,
        "updatedAt": "<TIME>",
        "version": 1
      },
      "location": "/api/v1/projects/<ID-1>/boards/<ID-2>",
      "status": 201
    }
  },
  {
    "name": "init a repository",
    "request": {
      "body": {
        "args": [
          "init",
          "-q",
          "-b",
          "main",
          "arches"
        ],
        "cwd": "<WORK>",
        "label": "git init",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
      "path": "/api/v1/runs"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "error": null,
        "exitCode": null,
        "finishedAt": null,
        "id": "<ID-4>",
        "label": "git init",
        "startedAt": "<TIME>",
        "status": "running",
        "version": 2
      },
      "location": "/api/v1/runs/<ID-4>",
      "status": 201
    }
  },
  {
    "field": "status",
    "name": "initialized",
    "reached": "succeeded",
    "wait": "/api/v1/runs/<ID-4>"
  },
  {
    "name": "first commit",
    "request": {
      "body": {
        "args": [
          "-c",
          "user.name=t",
          "-c",
          "user.email=t@example.com",
          "commit",
          "-q",
          "--allow-empty",
          "-m",
          "init"
        ],
        "cwd": "<WORK>/arches",
        "label": "git commit",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
      "path": "/api/v1/runs"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "error": null,
        "exitCode": null,
        "finishedAt": null,
        "id": "<ID-5>",
        "label": "git commit",
        "startedAt": "<TIME>",
        "status": "running",
        "version": 2
      },
      "location": "/api/v1/runs/<ID-5>",
      "status": 201
    }
  },
  {
    "field": "status",
    "name": "committed",
    "reached": "succeeded",
    "wait": "/api/v1/runs/<ID-5>"
  },
  {
    "name": "long paths on already, so every platform prints the same",
    "request": {
      "body": {
        "args": [
          "config",
          "core.longpaths",
          "true"
        ],
        "cwd": "<WORK>/arches",
        "label": "git config",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
      "path": "/api/v1/runs"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "error": null,
        "exitCode": null,
        "finishedAt": null,
        "id": "<ID-6>",
        "label": "git config",
        "startedAt": "<TIME>",
        "status": "running",
        "version": 2
      },
      "location": "/api/v1/runs/<ID-6>",
      "status": 201
    }
  },
  {
    "field": "status",
    "name": "configured",
    "reached": "succeeded",
    "wait": "/api/v1/runs/<ID-6>"
  },
  {
    "cli": [
      "board",
      "repo",
      "<ID-2>",
      "<WORK>/arches"
    ],
    "exitCode": 0,
    "name": "bind the board",
    "stderr": "",
    "stdout": "board <ID-2> works in arches at <WORK>/arches\n"
  },
  {
    "cli": [
      "ticket",
      "create",
      "Fix the login"
    ],
    "exitCode": 0,
    "name": "a ticket",
    "stderr": "",
    "stdout": "ARC-0001 created: Fix the login\n"
  },
  {
    "cli": [
      "ticket",
      "create",
      "Polish the login"
    ],
    "exitCode": 0,
    "name": "a second ticket",
    "stderr": "",
    "stdout": "ARC-0002 created: Polish the login\n"
  },
  {
    "cli": [
      "ticket",
      "start",
      "arc-1"
    ],
    "exitCode": 0,
    "name": "start in a new worktree",
    "stderr": "",
    "stdout": "ARC-0001 started on ticket/ARC-0001-fix-the-login in <WORK>/arches-worktrees/ARC-0001\n"
  },
  {
    "cli": [
      "ticket",
      "start",
      "ARC-2",
      "--join-ticket",
      "ARC-1"
    ],
    "exitCode": 0,
    "name": "the second ticket joins",
    "stderr": "",
    "stdout": "ARC-0002 joined ticket/ARC-0001-fix-the-login in <WORK>/arches-worktrees/ARC-0001\n"
  },
  {
    "cli": [
      "ticket",
      "done",
      "ARC-1"
    ],
    "exitCode": 1,
    "name": "done needs acceptance criteria",
    "stderr": "error: the daemon refused the request: a ticket is done only with acceptance criteria (acceptance-missing)\n",
    "stdout": ""
  },
  {
    "cli": [
      "ticket",
      "done",
      "ARC-1",
      "--acceptance",
      "The login works"
    ],
    "exitCode": 0,
    "name": "the first done leaves the worktree open for the second ticket",
    "stderr": "",
    "stdout": "ARC-0001 is done.\n"
  },
  {
    "cli": [
      "ticket",
      "done",
      "ARC-2",
      "--acceptance",
      "It shines"
    ],
    "exitCode": 0,
    "name": "the last done makes the worktree ready and removes it",
    "stderr": "",
    "stdout": "ARC-0002 is done.\nBranch ticket/ARC-0001-fix-the-login is ready to merge (nothing was merged).\nWorktree <WORK>/arches-worktrees/ARC-0001 removed (the branch stays).\n"
  },
  {
    "cli": [
      "ticket",
      "create",
      "Next thing"
    ],
    "exitCode": 0,
    "name": "a third ticket",
    "stderr": "",
    "stdout": "ARC-0003 created: Next thing\n"
  },
  {
    "cli": [
      "ticket",
      "start",
      "ARC-3"
    ],
    "exitCode": 0,
    "name": "start the third ticket",
    "stderr": "",
    "stdout": "ARC-0003 started on ticket/ARC-0003-next-thing in <WORK>/arches-worktrees/ARC-0003\n"
  },
  {
    "cli": [
      "ticket",
      "done",
      "ARC-3",
      "--acceptance",
      "Next is done"
    ],
    "exitCode": 0,
    "name": "done from inside the worktree keeps it",
    "stderr": "",
    "stdout": "ARC-0003 is done.\nBranch ticket/ARC-0003-next-thing is ready to merge (nothing was merged).\nWorktree <WORK>/arches-worktrees/ARC-0003 kept: the current folder is inside it.\n"
  },
  {
    "cli": [
      "ticket",
      "create",
      "Last thing"
    ],
    "exitCode": 0,
    "name": "a fourth ticket",
    "stderr": "",
    "stdout": "ARC-0004 created: Last thing\n"
  },
  {
    "cli": [
      "ticket",
      "start",
      "ARC-4"
    ],
    "exitCode": 0,
    "name": "the next start removes the ready worktree first",
    "stderr": "",
    "stdout": "ARC-0004 started on ticket/ARC-0004-last-thing in <WORK>/arches-worktrees/ARC-0004\nWorktree <WORK>/arches-worktrees/ARC-0003 removed (the branch stays).\n"
  },
  {
    "name": "the finished ticket keeps its branch",
    "request": {
      "method": "GET",
      "path": "/api/v1/tickets/ARC-0001"
    },
    "response": {
      "json": {
        "comments": [],
        "history": [
          {
            "actorId": "<ID-3>",
            "actorName": "tester",
            "at": "<TIME>",
            "field": "status",
            "from": null,
            "note": "created",
            "to": "backlog"
          },
          {
            "actorId": "<ID-3>",
            "actorName": "tester",
            "at": "<TIME>",
            "field": "status",
            "from": "backlog",
            "note": "started",
            "to": "in-progress"
          },
          {
            "actorId": "<ID-3>",
            "actorName": "tester",
            "at": "<TIME>",
            "field": "branch",
            "from": null,
            "note": "started",
            "to": "ticket/ARC-0001-fix-the-login"
          },
          {
            "actorId": "<ID-3>",
            "actorName": "tester",
            "at": "<TIME>",
            "field": "worktree",
            "from": null,
            "note": "started",
            "to": "<WORK>/arches-worktrees/ARC-0001"
          },
          {
            "actorId": "<ID-3>",
            "actorName": "tester",
            "at": "<TIME>",
            "field": "status",
            "from": "in-progress",
            "note": "moved",
            "to": "done"
          },
          {
            "actorId": "<ID-3>",
            "actorName": "tester",
            "at": "<TIME>",
            "field": "acceptance",
            "from": "",
            "note": "moved",
            "to": "The login works"
          }
        ],
        "steps": [],
        "ticket": {
          "acceptance": "The login works",
          "assignee": null,
          "blockedReason": null,
          "boardId": "<ID-2>",
          "branch": "ticket/ARC-0001-fix-the-login",
          "column": "done",
          "createdAt": "<TIME>",
          "createdById": "<ID-3>",
          "createdByName": "tester",
          "dependents": [],
          "dependsOn": [],
          "dependsOpen": [],
          "description": "",
          "diagram": "",
          "handbook": "",
          "id": "<ID-7>",
          "key": "ARC-0001",
          "labels": [],
          "needsPlanning": true,
          "number": 1,
          "plan": "",
          "plannedAt": null,
          "plannedBy": null,
          "planningClaimAt": null,
          "planningClaimBy": null,
          "priority": "normal",
          "projectId": "<ID-1>",
          "status": "done",
          "stepsDone": 0,
          "stepsTotal": 0,
          "targetBranch": null,
          "title": "Fix the login",
          "unlocks": [],
          "updatedAt": "<TIME>",
          "version": 3,
          "waiting": false,
          "worktree": "<WORK>/arches-worktrees/ARC-0001"
        }
      },
      "status": 200
    }
  },
  {
    "name": "list the worktrees",
    "request": {
      "body": {
        "args": [
          "-c",
          "core.abbrev=40",
          "worktree",
          "list"
        ],
        "cwd": "<WORK>/arches",
        "label": "git worktree list",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
      "path": "/api/v1/runs"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "error": null,
        "exitCode": null,
        "finishedAt": null,
        "id": "<ID-8>",
        "label": "git worktree list",
        "startedAt": "<TIME>",
        "status": "running",
        "version": 2
      },
      "location": "/api/v1/runs/<ID-8>",
      "status": 201
    }
  },
  {
    "field": "status",
    "name": "listed",
    "reached": "succeeded",
    "wait": "/api/v1/runs/<ID-8>"
  },
  {
    "cli": [
      "run",
      "logs",
      "<ID-8>"
    ],
    "exitCode": 0,
    "name": "only the main checkout and the new worktree",
    "stderr": "",
    "stdout": "<WORK>/arches                    <COMMIT> [main]\n<WORK>/arches-worktrees/ARC-0004 <COMMIT> [ticket/ARC-0004-last-thing]\n"
  },
  {
    "name": "list the branches",
    "request": {
      "body": {
        "args": [
          "branch",
          "--list"
        ],
        "cwd": "<WORK>/arches",
        "label": "git branch --list",
        "program": "git",
        "timeoutSeconds": 30
      },
      "method": "POST",
      "path": "/api/v1/runs"
    },
    "response": {
      "json": {
        "createdAt": "<TIME>",
        "error": null,
        "exitCode": null,
        "finishedAt": null,
        "id": "<ID-9>",
        "label": "git branch --list",
        "startedAt": "<TIME>",
        "status": "running",
        "version": 2
      },
      "location": "/api/v1/runs/<ID-9>",
      "status": 201
    }
  },
  {
    "field": "status",
    "name": "branches listed",
    "reached": "succeeded",
    "wait": "/api/v1/runs/<ID-9>"
  },
  {
    "cli": [
      "run",
      "logs",
      "<ID-9>"
    ],
    "exitCode": 0,
    "name": "the branch remains",
    "stderr": "",
    "stdout": "* main\n  ticket/ARC-0001-fix-the-login\n  ticket/ARC-0003-next-thing\n+ ticket/ARC-0004-last-thing\n"
  }
]
