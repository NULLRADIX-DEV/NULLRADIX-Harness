{
  "title": "A done ticket marks its worktree ready to merge and the cleanup removes it, keeping the branch",
  "steps": [
    {
      "name": "project",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects",
        "body": { "key": "ARC", "name": "Arches" }
      },
      "save": { "project": "json.id" }
    },
    {
      "name": "board",
      "http": {
        "method": "POST",
        "path": "/api/v1/projects/{{project}}/boards",
        "body": { "name": "Main" }
      },
      "save": { "main": "json.id" }
    },
    {
      "name": "init a repository",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git init",
          "program": "git",
          "args": ["init", "-q", "-b", "main", "arches"],
          "cwd": "{{WORK}}",
          "timeoutSeconds": 30
        }
      },
      "save": { "init": "json.id" }
    },
    {
      "name": "initialized",
      "wait": { "path": "/api/v1/runs/{{init}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "first commit",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git commit",
          "program": "git",
          "args": [
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@example.com",
            "commit",
            "-q",
            "--allow-empty",
            "-m",
            "init"
          ],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "commit": "json.id" }
    },
    {
      "name": "committed",
      "wait": { "path": "/api/v1/runs/{{commit}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "long paths on already, so every platform prints the same",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git config",
          "program": "git",
          "args": ["config", "core.longpaths", "true"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "config": "json.id" }
    },
    {
      "name": "configured",
      "wait": { "path": "/api/v1/runs/{{config}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "bind the board",
      "cli": { "args": ["board", "repo", "{{main}}", "{{WORK}}/arches"] }
    },
    {
      "name": "a ticket",
      "cli": { "args": ["ticket", "create", "Fix the login"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "a second ticket",
      "cli": { "args": ["ticket", "create", "Polish the login"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "start in a new worktree",
      "cli": { "args": ["ticket", "start", "arc-1"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "the second ticket joins",
      "cli": {
        "args": ["ticket", "start", "ARC-2", "--join-ticket", "ARC-1"],
        "cwd": "{{WORK}}/arches"
      }
    },
    {
      "name": "done needs acceptance criteria",
      "cli": { "args": ["ticket", "done", "ARC-1"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "the first done leaves the worktree open for the second ticket",
      "cli": {
        "args": ["ticket", "done", "ARC-1", "--acceptance", "The login works"],
        "cwd": "{{WORK}}/arches"
      }
    },
    {
      "name": "the last done makes the worktree ready and removes it",
      "cli": {
        "args": ["ticket", "done", "ARC-2", "--acceptance", "It shines"],
        "cwd": "{{WORK}}/arches"
      }
    },
    {
      "name": "a third ticket",
      "cli": { "args": ["ticket", "create", "Next thing"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "start the third ticket",
      "cli": { "args": ["ticket", "start", "ARC-3"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "done from inside the worktree keeps it",
      "cli": {
        "args": ["ticket", "done", "ARC-3", "--acceptance", "Next is done"],
        "cwd": "{{WORK}}/arches-worktrees/ARC-0003"
      }
    },
    {
      "name": "a fourth ticket",
      "cli": { "args": ["ticket", "create", "Last thing"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "the next start removes the ready worktree first",
      "cli": { "args": ["ticket", "start", "ARC-4"], "cwd": "{{WORK}}/arches" }
    },
    {
      "name": "the finished ticket keeps its branch",
      "http": { "method": "GET", "path": "/api/v1/tickets/ARC-0001" }
    },
    {
      "name": "list the worktrees",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git worktree list",
          "program": "git",
          "args": ["-c", "core.abbrev=40", "worktree", "list"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "list": "json.id" }
    },
    {
      "name": "listed",
      "wait": { "path": "/api/v1/runs/{{list}}", "field": "status", "equals": "succeeded" }
    },
    {
      "name": "only the main checkout and the new worktree",
      "cli": { "args": ["run", "logs", "{{list}}"] }
    },
    {
      "name": "list the branches",
      "http": {
        "method": "POST",
        "path": "/api/v1/runs",
        "body": {
          "label": "git branch --list",
          "program": "git",
          "args": ["branch", "--list"],
          "cwd": "{{WORK}}/arches",
          "timeoutSeconds": 30
        }
      },
      "save": { "branches": "json.id" }
    },
    {
      "name": "branches listed",
      "wait": { "path": "/api/v1/runs/{{branches}}", "field": "status", "equals": "succeeded" }
    },
    { "name": "the branch remains", "cli": { "args": ["run", "logs", "{{branches}}"] } }
  ]
}
