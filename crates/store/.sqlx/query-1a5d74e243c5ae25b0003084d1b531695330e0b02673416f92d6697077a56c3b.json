  "query": "SELECT l.ticket_id AS \"ticket_id: Uuid\", p.key AS project_key, t.number, l.position,\n                  l.joined_at, l.released_at\n           FROM worktree_tickets l\n           JOIN tickets t ON t.id = l.ticket_id\n           JOIN projects p ON p.id = t.project_id\n           WHERE l.worktree_id = ?\n           ORDER BY l.position",
