  "query": "SELECT l.note_id AS \"note_id: Uuid\", l.label\n           FROM note_labels l\n           JOIN notes n ON n.id = l.note_id\n           WHERE (?1 IS NULL OR n.board_id = ?1) AND (?2 IS NULL OR n.rid = ?2)\n           ORDER BY l.note_id, l.position",
