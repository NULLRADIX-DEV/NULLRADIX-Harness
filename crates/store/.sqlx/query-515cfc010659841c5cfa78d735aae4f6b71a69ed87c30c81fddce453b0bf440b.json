  "query": "SELECT qt.question_id AS \"question_id: Uuid\", qt.ticket_id AS \"ticket_id: Uuid\"\n           FROM question_tickets qt\n           JOIN questions q ON q.id = qt.question_id\n           JOIN tickets t ON t.id = qt.ticket_id\n           WHERE q.state = 'open'\n           ORDER BY t.number",
